@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix proposed: <http://example.org/ontology/proposed/> .

# Prototype extension ontology for UCO change proposal:
# "Industrial control device facet".
# Grounded in: NIST SP 800-82 Rev. 3 (https://doi.org/10.6028/NIST.SP.800-82r3),
# the MODBUS Application Protocol Specification V1.1b3
# (https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf), the ODVA
# CIP Identity Object, and OPC UA Part 8 Data Access
# (https://reference.opcfoundation.org/Core/Part8/v104/docs/5.6.4).

proposed:IndustrialControlDeviceFacet
    a owl:Class ;
    rdfs:subClassOf uco-core:Facet ;
    rdfs:label "IndustrialControlDeviceFacet"@en ;
    rdfs:comment "An industrial control device facet is a grouping of characteristics of an operational-technology controller or supervisory host (PLC, RTU, HMI, historian, engineering workstation) that DeviceFacet does not carry: OT role, firmware revision, control-program identity, rack/slot addressing and network zone. Composes alongside uco-observable:DeviceFacet, which keeps make, model and serial number. Roles follow NIST SP 800-82 Rev. 3 (https://doi.org/10.6028/NIST.SP.800-82r3)."@en .

proposed:IndustrialProcessEventFacet
    a owl:Class ;
    rdfs:subClassOf uco-core:Facet ;
    rdfs:label "IndustrialProcessEventFacet"@en ;
    rdfs:comment "An industrial process event facet is a grouping of characteristics of a historian, HMI or controller event about a physical process: tag name, engineering unit, process value, setpoint before and after a change, and the industrial-protocol function and object address involved. Composes with uco-observable:EventRecordFacet on the same uco-observable:EventRecord. Process value and setpoint follow OPC 40001-2 (https://reference.opcfoundation.org/Machinery/ProcessValues/v100/docs/)."@en .

proposed:controllerRole
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:string ;
    rdfs:label "controllerRole"@en ;
    rdfs:comment "The OT role of the device, e.g. plc, rtu, hmi, historian or engineering-workstation, per the topologies in NIST SP 800-82 Rev. 3 section 2 (https://doi.org/10.6028/NIST.SP.800-82r3)."@en .

proposed:firmwareRevision
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:string ;
    rdfs:label "firmwareRevision"@en ;
    rdfs:comment "The controller or supervisory firmware revision as reported by the device, e.g. the ODVA CIP Identity Object (class 0x01) attribute 4 Revision (https://www.odva.org/wp-content/uploads/2020/05/PUB00213R0_EtherNetIP_Developers_Guide.pdf)."@en .

proposed:programIdentity
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:string ;
    rdfs:label "programIdentity"@en ;
    rdfs:comment "The identity of the control program or project loaded on the controller (project name, program checksum or logic identity string), as recovered from engineering software or controller memory; programs follow IEC 61131-3 (https://webstore.iec.ch/en/publication/68533)."@en .

proposed:rackNumber
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:integer ;
    rdfs:label "rackNumber"@en ;
    rdfs:comment "The chassis or rack number of the module, as used in vendor engineering software and CIP path addressing (https://www.odva.org/wp-content/uploads/2020/05/PUB00213R0_EtherNetIP_Developers_Guide.pdf)."@en .

proposed:slotNumber
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:integer ;
    rdfs:label "slotNumber"@en ;
    rdfs:comment "The slot number of the CPU or communications module within its rack, as used in CIP path addressing (https://www.odva.org/wp-content/uploads/2020/05/PUB00213R0_EtherNetIP_Developers_Guide.pdf)."@en .

proposed:otNetworkZone
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialControlDeviceFacet ;
    rdfs:range xsd:string ;
    rdfs:label "otNetworkZone"@en ;
    rdfs:comment "The zone or conduit label from the site OT architecture where the device was observed, e.g. a Purdue level or OT VLAN name, per ISA/IEC 62443 zones and conduits (https://www.isa.org/standards-and-publications/isa-standards/isa-iec-62443-series-of-standards)."@en .

proposed:processTagName
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:string ;
    rdfs:label "processTagName"@en ;
    rdfs:comment "The historian, HMI or controller tag (point) name the event refers to, e.g. PUMP3_DISCHARGE_PSI; corresponds to SignalTag in OPC 40001-2 (https://reference.opcfoundation.org/Machinery/ProcessValues/v100/docs/)."@en .

proposed:engineeringUnit
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:string ;
    rdfs:label "engineeringUnit"@en ;
    rdfs:comment "The unit of measure of the process value and setpoints, e.g. psi or degC, per OPC UA Part 8 EngineeringUnits (https://reference.opcfoundation.org/Core/Part8/v104/docs/5.6.4)."@en .

proposed:processValue
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:decimal ;
    rdfs:label "processValue"@en ;
    rdfs:comment "The observed process value at the time of the event, per the process value variable of OPC 40001-2 (https://reference.opcfoundation.org/Machinery/ProcessValues/v100/docs/)."@en .

proposed:setpointValue
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:decimal ;
    rdfs:label "setpointValue"@en ;
    rdfs:comment "The setpoint in force at the time of the event, per the setpoint variable of OPC 40001-2 (https://reference.opcfoundation.org/Machinery/ProcessValues/v100/docs/)."@en .

proposed:priorSetpointValue
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:decimal ;
    rdfs:label "priorSetpointValue"@en ;
    rdfs:comment "The setpoint in force before a change the event records, when the evidence shows one (https://reference.opcfoundation.org/Machinery/ProcessValues/v100/docs/)."@en .

proposed:protocolFunctionCode
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:string ;
    rdfs:label "protocolFunctionCode"@en ;
    rdfs:comment "The industrial-protocol function or service identifier involved, e.g. Modbus function code 16 (Write Multiple Registers) per the MODBUS Application Protocol Specification V1.1b3 section 6 (https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf), or a CIP service code."@en .

proposed:protocolObjectAddress
    a owl:DatatypeProperty ;
    rdfs:domain proposed:IndustrialProcessEventFacet ;
    rdfs:range xsd:string ;
    rdfs:label "protocolObjectAddress"@en ;
    rdfs:comment "The register, object or point address targeted, e.g. a Modbus starting address per the MODBUS Application Protocol Specification V1.1b3 (https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf) or a CIP class/instance/attribute path."@en .
