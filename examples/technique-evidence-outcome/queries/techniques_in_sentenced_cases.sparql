PREFIX legalproc: <https://ontology.caseontology.org/case/criminal/>
PREFIX solveit-core: <https://ontology.solveit-df.org/solveit/core/>

SELECT DISTINCT ?technique
WHERE {
  ?sentence a legalproc:Sentence ;
            legalproc:sentenceStatus "imposed" ;
            legalproc:outcomeScope "current-case" .
  ?action a solveit-core:SolveitInvestigativeAction , ?technique .
  FILTER(STRSTARTS(STR(?technique), "https://ontology.solveit-df.org/solveit/data/technique"))
}
ORDER BY ?technique
