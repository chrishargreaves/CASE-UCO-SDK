{
  "name": "smishviz",
  "display_name": "SmishViz Campaign and Social-Engineering Annotation Extension",
  "version": "0.1.0",
  "upstream_repo": "https://github.com/varnicm/smishviz-case-uco",
  "upstream_ref": "main",
  "license": "Apache-2.0",
  "namespaces": {
    "smish": "https://reactlab.org/smishviz/ontology/"
