#
# Tactics (annotation values)
#

atlas-tactic:AML.TA0000
	rdfs:label "AI Model Access"@en ;
	rdfs:comment "The adversary is attempting to gain some level of access to an AI model."@en ;
	dcterms:identifier "AML.TA0000" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	.

atlas-tactic:AML.TA0001
	rdfs:label "AI Attack Adaptation"@en ;
	rdfs:comment "The adversary is adapting capabilities, methods, knowledge, or objectives into attack-ready outputs for a target or current operational conditions."@en ;
	dcterms:identifier "AML.TA0001" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	.

atlas-tactic:AML.TA0002
	rdfs:label "Reconnaissance"@en ;
	rdfs:comment "The adversary is trying to gather information about the AI system they can use to plan future operations."@en ;
	dcterms:identifier "AML.TA0002" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0043> ;
	.

atlas-tactic:AML.TA0003
	rdfs:label "Resource Development"@en ;
	rdfs:comment "The adversary is trying to establish resources they can use to support operations."@en ;
	dcterms:identifier "AML.TA0003" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0042> ;
	.

atlas-tactic:AML.TA0004
	rdfs:label "Initial Access"@en ;
	rdfs:comment "The adversary is trying to gain access to the AI system."@en ;
	dcterms:identifier "AML.TA0004" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0001> ;
	.

atlas-tactic:AML.TA0005
	rdfs:label "Execution"@en ;
	rdfs:comment "The adversary is trying to run malicious code embedded in AI artifacts or software."@en ;
	dcterms:identifier "AML.TA0005" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0002> ;
	.

atlas-tactic:AML.TA0006
	rdfs:label "Persistence"@en ;
	rdfs:comment "The adversary is trying to maintain their foothold via AI artifacts or software."@en ;
	dcterms:identifier "AML.TA0006" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0003> ;
	.

atlas-tactic:AML.TA0007
	rdfs:label "Defense Evasion"@en ;
	rdfs:comment "The adversary is trying to avoid being detected by AI-enabled security software."@en ;
	dcterms:identifier "AML.TA0007" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0005> ;
	.

atlas-tactic:AML.TA0008
	rdfs:label "Discovery"@en ;
	rdfs:comment "The adversary is trying to figure out your AI environment."@en ;
	dcterms:identifier "AML.TA0008" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0007> ;
	.

atlas-tactic:AML.TA0009
	rdfs:label "Collection"@en ;
	rdfs:comment "The adversary is trying to gather AI artifacts and other related information relevant to their goal."@en ;
	dcterms:identifier "AML.TA0009" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0009> ;
	.

atlas-tactic:AML.TA0010
	rdfs:label "Exfiltration"@en ;
	rdfs:comment "The adversary is trying to steal AI artifacts or other information about the AI system."@en ;
	dcterms:identifier "AML.TA0010" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0010> ;
	.

atlas-tactic:AML.TA0011
	rdfs:label "Impact"@en ;
	rdfs:comment "The adversary is trying to manipulate, interrupt, erode confidence in, or destroy your AI systems and data."@en ;
	dcterms:identifier "AML.TA0011" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0040> ;
	.

atlas-tactic:AML.TA0012
	rdfs:label "Privilege Escalation"@en ;
	rdfs:comment "The adversary is trying to gain higher-level permissions."@en ;
	dcterms:identifier "AML.TA0012" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0004> ;
	.

atlas-tactic:AML.TA0013
	rdfs:label "Credential Access"@en ;
	rdfs:comment "The adversary is trying to steal account names and passwords."@en ;
	dcterms:identifier "AML.TA0013" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0006> ;
	.

atlas-tactic:AML.TA0014
	rdfs:label "Command and Control"@en ;
	rdfs:comment "The adversary is trying to communicate with compromised AI systems to control them."@en ;
	dcterms:identifier "AML.TA0014" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0011> ;
	.

atlas-tactic:AML.TA0015
	rdfs:label "Lateral Movement"@en ;
	rdfs:comment "The adversary is trying to move through your AI environment."@en ;
	dcterms:identifier "AML.TA0015" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	rdfs:seeAlso <https://attack.mitre.org/tactics/TA0008> ;
	.

#
# Techniques and sub-techniques
#

atlas:AML.T0000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Search Open Technical Databases"@en ;
	rdfs:comment "Adversaries may search for publicly available research and technical documentation to learn how and where AI is used within a victim organization. The adversary can use this information to identify targets for attack, or to tailor an existing attack to make it more effective. Organizations often use open source model architectures trained on additional proprietary data in production. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0000" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1596> ;
	.

atlas:AML.T0000.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0000 ;
	rdfs:label "Search Open Technical Databases: Journals and Conference Proceedings"@en ;
	rdfs:comment "Many of the publications accepted at premier artificial intelligence conferences and journals come from commercial labs. Some journals and conferences are open access, others may require paying for access or a membership. These publications will often describe in detail all aspects of a particular approach for reproducibility. This information can be used by adversaries to implement the paper. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0000.000" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0000.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0000 ;
	rdfs:label "Search Open Technical Databases: Pre-Print Repositories"@en ;
	rdfs:comment "Pre-Print repositories, such as arXiv, contain the latest academic research papers that haven't been peer reviewed. They may contain research notes, or technical reports that aren't typically published in journals or conference proceedings. Pre-print repositories also serve as a central location to share papers that have been accepted to journals. Searching pre-print repositories provides adversaries with a relatively up-to-date view of what researchers in the victim organization are working on. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0000.001" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1596> ;
	.

atlas:AML.T0000.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0000 ;
	rdfs:label "Search Open Technical Databases: Technical Blogs"@en ;
	rdfs:comment "Research labs at academic institutions and company R&D divisions often have blogs that highlight their use of artificial intelligence and its application to the organization's unique problems. Individual researchers also frequently document their work in blog posts. An adversary may search for posts made by the target victim organization or its employees. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0000.002" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1596> ;
	.

atlas:AML.T0000.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0000 ;
	rdfs:label "Search Open Technical Databases: Scan Databases"@en ;
	rdfs:comment "Adversaries may search public internet-scan services to identify a victim's exposed AI infrastructure. These services, such as Shodan and Censys, continuously scan the internet and publish the active IP addresses, hostnames, open ports, and service banners, which adversaries can query without interacting with the target directly. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0000.003" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1596.005> ;
	.

atlas:AML.T0001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Search Open AI Vulnerability Analysis"@en ;
	rdfs:comment "Much like the Search Open Technical Databases, there is often ample research available on the vulnerabilities of common AI models. Once a target has been identified, an adversary will likely try to identify any pre-existing work that has been done for this class of models. This will include not only reading academic papers that may identify the particulars of a successful attack, but also identifying pre-existing implementations of those attacks. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0001" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Acquire Public AI Artifacts"@en ;
	rdfs:comment "Adversaries may search public sources, including cloud storage, public-facing services, and software or data repositories, to identify AI artifacts. These AI artifacts may include the software stack used to train and deploy models, training and testing data, model configurations and parameters. An adversary will be particularly interested in artifacts hosted by or associated with the victim organization as they may represent what that organization uses in a production environment. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0002.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0002 ;
	rdfs:label "Acquire Public AI Artifacts: Datasets"@en ;
	rdfs:comment "Adversaries may collect public datasets to use in their operations. Datasets used by the victim organization or datasets that are representative of the data used by the victim organization may be valuable to adversaries. Datasets can be stored in cloud storage, or on victim-owned websites. Some datasets require the adversary to Establish Accounts for access. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0002.000" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0002.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0002 ;
	rdfs:label "Acquire Public AI Artifacts: Models"@en ;
	rdfs:comment "Adversaries may acquire public models to use in their operations. Adversaries may seek models used by the victim organization or models that are representative of those used by the victim organization. Representative models may include model architectures, or pre-trained models which define the architecture as well as model parameters from training on a dataset. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0002.001" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0002.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0002 ;
	rdfs:label "Acquire Public AI Artifacts: AI Agent Configuration"@en ;
	rdfs:comment "Adversaries may acquire publicly accessible AI agent configuration files to understand agent capabilities, gain unauthorized access to tools and data sources, or identify credentials for further attacks. Configuration files define what tools an agent can use, credentials for external services, system prompts, and behavioral settings, making them valuable resources for adversaries targeting AI agent deployments. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0002.002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Search Victim-Owned Websites"@en ;
	rdfs:comment "Adversaries may search websites owned by the victim for information that can be used during targeting. Victim-owned websites may contain technical details about their AI-enabled products or services. Victim-owned websites may contain a variety of details, including names of departments/divisions, physical locations, and data about key employees such as names, roles, and contact info. These sites may also have details highlighting business operations and relationships. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0003" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1594> ;
	.

atlas:AML.T0004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Search Application Repositories"@en ;
	rdfs:comment "Adversaries may search open application repositories during targeting. Examples of these include Google Play, the iOS App store, the macOS App Store, and the Microsoft Store. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0004" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Create Proxy AI Model"@en ;
	rdfs:comment "Adversaries may obtain models to serve as proxies for the target model in use at the victim organization. Proxy models are used to simulate complete access to the target model in a fully offline manner. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0005" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0005.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0005 ;
	rdfs:label "Create Proxy AI Model: Train Proxy via Gathered AI Artifacts"@en ;
	rdfs:comment "Proxy models may be trained from AI artifacts (such as data, model architectures, and pre-trained models) that are representative of the target model gathered by the adversary. This can be used to develop attacks that require higher levels of access than the adversary has available or as a means to validate pre-existing attacks without interacting with the target model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0005.000" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0005.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0005 ;
	rdfs:label "Create Proxy AI Model: Train Proxy via Replication"@en ;
	rdfs:comment "Adversaries may replicate a private model. By repeatedly querying the victim's AI Model Inference API Access, the adversary can collect the target model's inferences into a dataset. The inferences are used as labels for training a separate model offline that will mimic the behavior and performance of the target model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0005.001" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0005.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0005 ;
	rdfs:label "Create Proxy AI Model: Use Pre-Trained Model"@en ;
	rdfs:comment "Adversaries may use an off-the-shelf pre-trained model as a proxy for the victim model to aid in staging the attack. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0005.002" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0006
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Active Scanning"@en ;
	rdfs:comment "Adversaries may actively scan for publicly reachable AI systems and resources for targeting. They may identify resources or systems that are misconfigured or are known vulnerable versions. This is distinct from other reconnaissance techniques that do not involve direct interaction with the victim system. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0006" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1595> ;
	.

atlas:AML.T0006.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0006 ;
	rdfs:label "Active Scanning: Enumerate Hosted AI Resources"@en ;
	rdfs:comment "Adversaries may directly probe an agentic or SaaS platform to enumerate the resources a specific victim has deployed on it. Platforms frequently host AI agents behind predictable URL structures derived from identifiers such as environment, tenant, resource-group, or agent names, and default out-of-the-box deployment configurations keep these conventions consistent across victims. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0006.000" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0006.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0006 ;
	rdfs:label "Active Scanning: Query Platform Metadata APIs"@en ;
	rdfs:comment "Adversaries may query documented or undocumented APIs in agentic SaaS hosting platforms to uncover agentic targets. SaaS and agentic platforms can expose provider control-plane or identity APIs that return tenant, environment, or deployment information IDs, including for resources that are misconfigured or unintentionally accessible by unauthenticated users. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0006.001" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0006.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0006 ;
	rdfs:label "Active Scanning: Scan for Exposed AI Infrastructure"@en ;
	rdfs:comment "Adversaries may scan network ports and services to identify deployed AI backends, model-serving endpoints, and AI agent infrastructure reachable over the internet. Self-hosted AI runtimes typically listen on predictable, well-known ports and expose standard API paths, allowing adversaries to efficiently locate candidate hosts and infer the platform running on them. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0006.002" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1595> ;
	.

atlas:AML.T0006.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0006 ;
	rdfs:label "Active Scanning: Probe AI Agent Trigger Channels"@en ;
	rdfs:comment "Adversaries may send crafted inputs to potential public triggers, such as email addresses, webhooks, or messaging channels, to elicit a response that indicates an invocation of agentic activity. The nature of the response and its content can often reveal agent-managed accounts and expose the additional agentic attack surface. Identified triggers can be used to directly attack the agent. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0006.003" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1595> ;
	.

atlas:AML.T0007
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Artifacts"@en ;
	rdfs:comment "Adversaries may search private sources to identify AI learning artifacts that exist on the system and gather information about them. These artifacts can include the software stack used to train and deploy models, training and testing data management systems, container registries, software repositories, and model zoos. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0007" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0008
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Acquire Infrastructure"@en ;
	rdfs:comment "Adversaries may buy, lease, or rent infrastructure for use throughout their operation. A wide variety of infrastructure exists for hosting and orchestrating adversary operations. Infrastructure solutions include physical or cloud servers, domains, mobile devices, and third-party web services. Free resources may also be used, but they are typically limited. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0008" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1583> ;
	.

atlas:AML.T0008.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: AI Development Workspaces"@en ;
	rdfs:comment "Developing and staging AI attacks often requires expensive compute resources. Adversaries may need access to one or many GPUs in order to develop an attack. They may try to anonymously use free resources such as Google Colaboratory, or cloud resources such as AWS, Azure, or Google Cloud as an efficient way to stand up temporary resources to conduct operations. Multiple workspaces may be used to avoid detection. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0008.000" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0008.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: Consumer Hardware"@en ;
	rdfs:comment "Adversaries may acquire consumer hardware to conduct their attacks. Owning the hardware provides the adversary with complete control of the environment. These devices can be hard to trace. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0008.001" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0008.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: Domains"@en ;
	rdfs:comment "Adversaries may acquire domains that can be used during targeting. Domain names are the human readable names used to represent one or more IP addresses. They can be purchased or, in some cases, acquired for free. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0008.002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1583.001> ;
	.

atlas:AML.T0008.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: Physical Countermeasures"@en ;
	rdfs:comment "Adversaries may acquire or manufacture physical countermeasures to aid or support their attack. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0008.003" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0008.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: Serverless"@en ;
	rdfs:comment "Adversaries may purchase and configure serverless cloud infrastructure, such as Cloudflare Workers, AWS Lambda functions, or Google Apps Scripts, that can be used during targeting. By utilizing serverless infrastructure, adversaries can make it more difficult to attribute infrastructure used during operations back to them. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0008.004" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1583.007> ;
	.

atlas:AML.T0008.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0008 ;
	rdfs:label "Acquire Infrastructure: AI Service Proxies"@en ;
	rdfs:comment "Adversaries may utilize commercial proxy services that resell access to AI services such as frontier model APIs. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0008.005" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Supply Chain Compromise"@en ;
	rdfs:comment "Adversaries may gain initial access to a system by compromising the unique portions of the AI supply chain. This could include Hardware, Data and its annotations, parts of the AI Software stack, or the Model itself. In some instances the attacker will need secondary access to fully carry out an attack using compromised components of the supply chain. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0010" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: Hardware"@en ;
	rdfs:comment "Adversaries may target AI systems by disrupting or manipulating the hardware supply chain. AI models often run on specialized hardware such as GPUs, TPUs, or embedded devices, but may also be optimized to operate on CPUs. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0010.000" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: AI Software"@en ;
	rdfs:comment "Adversaries may target software packages that are commonly used in AI-enabled systems or are part of the AI DevOps lifecycle. This can include deep learning frameworks used to build AI models (e.g. PyTorch, TensorFlow, Jax), generative AI integration frameworks (e.g. LangChain, LangFlow), inference engines, and AI DevOps tools. They may also target the dependency chains of any of these software packages [[pytorch]]. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0010.001" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: Data"@en ;
	rdfs:comment "Data is a key vector of supply chain compromise for adversaries. Every AI project will require some form of data. Many rely on large open source datasets that are publicly available. An adversary could rely on compromising these sources of data. The malicious data could be a result of Poison Training Data or include traditional malware. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0010.002" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: Model"@en ;
	rdfs:comment "AI-enabled systems often rely on open-source models in various ways. Most commonly, the victim organization may be using these models for fine-tuning. These models will be downloaded from an external source and then used as the base for the model as it is tuned on a smaller, private dataset. Loading models often requires executing some saved code in the form of a saved model file. These can be compromised with traditional malware, or through some adversarial AI techniques. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0010.003" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: Container Registry"@en ;
	rdfs:comment "An adversary may compromise a victim's container registry by pushing a manipulated container image and overwriting an existing container name and/or tag. Users of the container registry as well as automated CI/CD pipelines may pull the adversary's container image, compromising their AI Supply Chain. This can affect development and deployment environments. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0010.004" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0010.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0010 ;
	rdfs:label "AI Supply Chain Compromise: AI Agent Tool"@en ;
	rdfs:comment "Adversaries may target AI agent tools as a means to compromise a victim's AI supply chain. Tools add capabilities to AI agents, allowing them to interact with other services, connect to data sources, access internet resources, run system tools, and execute code. They are an attractive target for adversaries because compromising an AI agent can provide them with broad access and permissions on the victim's system via the agent's other tools. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0010.005" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0011
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "User Execution"@en ;
	rdfs:comment "An adversary may rely upon a user to load, execute, interpret, or otherwise use a malicious or unsafe artifact. In AI systems, user execution may include loading a model or causing an inference runtime to process executable or behavior-shaping components bundled with an AI artifact. The resulting effect may include host code execution or malicious AI behavior. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0011" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0011.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0011 ;
	rdfs:label "User Execution: Unsafe AI Artifacts"@en ;
	rdfs:comment "Adversaries may develop new AI artifacts or manipulate existing AI artifacts that have a deleterious effect when loaded, executed, interpreted, or used for inference by a victim. The unsafe artifacts may continue to work as expected from the victim's perspective. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0011.000" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0011.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0011 ;
	rdfs:label "User Execution: Malicious Package"@en ;
	rdfs:comment "Adversaries may develop malicious software packages that when imported by a user have a deleterious effect. Malicious packages may behave as expected to the user. They may be introduced via AI Supply Chain Compromise. They may not present as obviously malicious to the user and may appear to be useful for an AI-related task. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0011.001" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0011.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0011 ;
	rdfs:label "User Execution: Poisoned AI Agent Tool"@en ;
	rdfs:comment "A victim may invoke a poisoned tool when interacting with an AI agent. Invocation may expose the agent to poisoned definitions or responses, execute malicious tool implementation logic, or cause the agent to invoke additional tools. Poisoned tools may be introduced through AI software, installed packages, skills, or connections to remotely hosted services. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0011.002" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0011.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0011 ;
	rdfs:label "User Execution: Malicious Link"@en ;
	rdfs:comment "An adversary may rely upon a user clicking a malicious link in order to gain execution. Users may be subjected to social engineering to get them to click on a link that will lead to code execution. This user action will typically be observed as follow-on behavior from Spearphishing Link. Clicking on a link may also lead to other execution techniques such as exploitation of a browser or application vulnerability via Exploitation for Client Execution. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0011.003" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204> ;
	.

atlas:AML.T0012
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Valid Accounts"@en ;
	rdfs:comment "Adversaries may obtain and abuse credentials of existing accounts as a means of gaining Initial Access. Credentials may take the form of usernames and passwords of individual user accounts or API keys that provide access to various AI resources and services. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0012" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0012 ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1078> ;
	.

atlas:AML.T0013
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Model Ontology"@en ;
	rdfs:comment "Adversaries may discover the ontology of an AI model's output space, for example, the types of objects a model can detect. The adversary may discover the ontology by repeated queries to the model, forcing it to enumerate its output space. Or the ontology may be discovered in a configuration file or in documentation about the model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0013" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0014
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Model Family"@en ;
	rdfs:comment "Adversaries may discover the general family of a model. General information about the model may be revealed in documentation, or the adversary may use carefully constructed examples and analyze the model's responses to categorize it. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0014" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0015
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Evade AI Model"@en ;
	rdfs:comment "Adversaries can Craft Adversarial Data that prevents an AI model from correctly identifying the contents of the data or Generate Deepfakes that fools an AI model expecting authentic data. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0015" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0016
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Obtain Capabilities"@en ;
	rdfs:comment "Adversaries may search for and obtain software capabilities for use in their operations. Capabilities may be specific to AI-based attacks Adversarial AI Attack Implementations or generic software tools repurposed for malicious intent (Software Tools). In both instances, an adversary may modify or customize the capability to aid in targeting a particular AI-enabled system. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1588> ;
	.

atlas:AML.T0016.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0016 ;
	rdfs:label "Obtain Capabilities: Adversarial AI Attack Implementations"@en ;
	rdfs:comment "Adversaries may search for existing open source implementations of AI attacks. The research community often publishes their code for reproducibility and to further future research. Libraries intended for research purposes, such as CleverHans, the Adversarial Robustness Toolbox, and FoolBox, can be weaponized by an adversary. Adversaries may also obtain and use tools that were not originally designed for adversarial AI attacks as part of their attack. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016.000" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0016.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0016 ;
	rdfs:label "Obtain Capabilities: Software Tools"@en ;
	rdfs:comment "Adversaries may search for and obtain software tools to support their operations. Software designed for legitimate use may be repurposed by an adversary for malicious intent. An adversary may modify or customize software tools to achieve their purpose. Software tools used to support attacks on AI systems are not necessarily AI-based themselves. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016.001" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1588.002> ;
	.

atlas:AML.T0016.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0016 ;
	rdfs:label "Obtain Capabilities: Generative AI"@en ;
	rdfs:comment "Adversaries may search for and obtain generative AI models or tools, such as large language models (LLMs), to assist them in various steps of their operation. Generative AI can be used in a variety of malicious ways, such as to generate malware, to Generate Deepfakes, to Generate Malicious Commands, for Retrieval Content Crafting, or to generate Phishing content. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016.002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0016.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0016 ;
	rdfs:label "Obtain Capabilities: Exploits"@en ;
	rdfs:comment "Adversaries may search for and obtain exploits to support their operations. An exploit takes advantage of a bug or vulnerability in order to cause unintended or unanticipated behavior to occur on computer hardware or software. Exploits may be downloaded from public repositories, acquired from private sources, purchased, stolen, or obtained from vulnerability research and exploit-sharing communities. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016.003" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1588.005> ;
	.

atlas:AML.T0016.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0016 ;
	rdfs:label "Obtain Capabilities: AI Agent Tools"@en ;
	rdfs:comment "Adversaries may search for and obtain tools extend the capabilities of an AI agent. These capabilities may allow an agent to interact with operating systems, browsers, networks, cloud services, data stores, software repositories, identity systems, or other external resources. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0016.004" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0017
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Develop Capabilities"@en ;
	rdfs:comment "Adversaries may develop their own capabilities to support operations. This process encompasses identifying requirements, building or adapting solutions, validating or packaging capabilities, and preparing them for deployment. Capabilities used to support attacks on AI-enabled systems are not necessarily AI-based themselves. Adversaries may also use autonomous AI agents to iteratively develop capabilities, including exploit methods for known or previously unknown software vulnerabilities. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0017" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1587> ;
	.

atlas:AML.T0017.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0017 ;
	rdfs:label "Develop Capabilities: Adversarial AI Attacks"@en ;
	rdfs:comment "Adversaries may develop their own adversarial attacks. They may leverage existing libraries as a starting point (Adversarial AI Attack Implementations). They may implement ideas described in public research papers or develop custom made attacks for the victim model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0017.000" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0017.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0017 ;
	rdfs:label "Develop Capabilities: Autonomous Exploit Development"@en ;
	rdfs:comment "An autonomous AI agent may identify a software vulnerability and develop or materially adapt an exploit capability with limited human direction. The agent may analyze source code, documentation, service behavior, and error responses to infer a vulnerability and the conditions required to exploit it. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0017.001" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0017.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0017 ;
	rdfs:label "Develop Capabilities: AI Agent Tools"@en ;
	rdfs:comment "Adversaries may develop or materially adapt tools, integrations, or tool servers designed to extend the capabilities of an AI agent. These capabilities may allow an agent to interact with operating systems, browsers, networks, cloud services, data stores, software repositories, identity systems, or other external resources. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0017.002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0018
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Manipulate AI Model"@en ;
	rdfs:comment "Adversaries may manipulate an AI model artifact or its bundled components to change AI system behavior, introduce malicious code, or establish persistent malicious functionality. This may include modifying model weights, model architecture, or prompt-construction logic. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0018" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0018.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0018 ;
	rdfs:label "Manipulate AI Model: Poison AI Model"@en ;
	rdfs:comment "Adversaries may manipulate an AI model's weights to change it's behavior or performance, resulting in a poisoned model. Adversaries may poison a model by directly manipulating its weights, training the model on poisoned data, further fine-tuning the model, or otherwise interfering with its training process. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0018.000" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0018.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0018 ;
	rdfs:label "Manipulate AI Model: Modify AI Model Architecture"@en ;
	rdfs:comment "Adversaries may directly modify an AI model's architecture to re-define it's behavior. This can include adding or removing layers as well as adding pre or post-processing operations. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0018.001" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0018.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0018 ;
	rdfs:label "Manipulate AI Model: Embed Malware"@en ;
	rdfs:comment "Adversaries may embed malicious code into AI Model files. AI models may be packaged as a combination of instructions and weights. Some formats such as pickle files are unsafe to deserialize because they can contain unsafe calls such as exec. Models with embedded malware may still operate as expected. It may allow them to achieve Execution, Command & Control, or Exfiltrate Data. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0018.002" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0018.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0018 ;
	rdfs:label "Manipulate AI Model: Modify Prompt Construction Logic"@en ;
	rdfs:comment "Adversaries may modify templates, role delimiters, embedded system instructions, tokenizer settings, tool-call formatting, or other artifact-bundled logic that constructs the context sent to an AI model. Model file formats such as GGUF can package this logic alongside model weights in a single distributable artifact. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0018.003" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0020
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Training Data Poisoning"@en ;
	rdfs:comment "Adversaries may manipulate data used for training or fine-tuning an AI model to influence the resulting model's behavior. Adversaries may add, remove, or modify data samples; alter labels or annotations; or manipulate feedback and data-collection processes. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0020" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0021
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Establish Accounts"@en ;
	rdfs:comment "Adversaries may create accounts with various services for use in targeting, to gain access to resources needed in AI Attack Staging, or for victim impersonation. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0021" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1585> ;
	.

atlas:AML.T0024
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exfiltration via AI Inference API"@en ;
	rdfs:comment "Adversaries may exfiltrate private information via AI Model Inference API Access. AI Models have been shown leak private information about their training data (e.g. Infer Training Data Membership, Invert AI Model). The model itself may also be extracted (Extract AI Model) for the purposes of AI Intellectual Property Theft. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0024" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0024.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0024 ;
	rdfs:label "Exfiltration via AI Inference API: Infer Training Data Membership"@en ;
	rdfs:comment "Adversaries may infer the membership of a data sample or global characteristics of the data in its training set, which raises privacy concerns. Some strategies make use of a shadow model that could be obtained via Train Proxy via Replication, others use statistics of model prediction scores. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0024.000" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0024.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0024 ;
	rdfs:label "Exfiltration via AI Inference API: Invert AI Model"@en ;
	rdfs:comment "AI models' training data could be reconstructed by exploiting the confidence scores that are available via an inference API. By querying the inference API strategically, adversaries can back out potentially private information embedded within the training data. This could lead to privacy violations if the attacker can reconstruct the data of sensitive features used in the algorithm. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0024.001" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0024.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0024 ;
	rdfs:label "Exfiltration via AI Inference API: Extract AI Model"@en ;
	rdfs:comment "Adversaries may extract a functional copy of a private model. By repeatedly querying the victim's AI Model Inference API Access, the adversary can collect the target model's inferences into a dataset. The inferences are used as labels for training a separate model offline that will mimic the behavior and performance of the target model. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0024.002" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0025
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exfiltration via Cyber Means"@en ;
	rdfs:comment "Adversaries may exfiltrate AI artifacts or other information relevant to their goals via traditional cyber means. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0025" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0029
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Denial of AI Service"@en ;
	rdfs:comment "Adversaries may target AI-enabled systems with a flood of requests for the purpose of degrading or shutting down the service. Since many AI systems require significant amounts of specialized compute, they are often expensive bottlenecks that can become overloaded. Adversaries can intentionally craft inputs that require heavy amounts of useless compute from the AI system. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0029" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0031
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Erode AI Model Integrity"@en ;
	rdfs:comment "Adversaries may degrade the target model's performance with adversarial data inputs to erode confidence in the system over time. This can lead to the victim organization wasting time and money both attempting to fix the system and performing the tasks it was meant to automate by hand. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0031" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0034
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Cost Harvesting"@en ;
	rdfs:comment "Adversaries may deliberately drive a victim's AI services beyond normal operating capacity with the intent of increasing the cost of services. This may be achieved via high-volume, low-complexity queries (Excessive Queries) or low-volume, high-complexity queries (Resource-Intensive Queries). In Generative AI or Agentic AI systems, adversarial prompts may be introduced into the model's context to cause (Agentic Resource Consumption). ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0034" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0034.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0034 ;
	rdfs:label "Cost Harvesting: Excessive Queries"@en ;
	rdfs:comment "Adversaries may send an excessive number of otherwise normal or low-complexity queries to an AI system with the goal of overwhelming its capacity and increasing operating costs. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0034.000" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0034.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0034 ;
	rdfs:label "Cost Harvesting: Resource-Intensive Queries"@en ;
	rdfs:comment "Adversaries may craft inputs specifically designed to increase the compute resources required for processing. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0034.001" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0034.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0034 ;
	rdfs:label "Cost Harvesting: Agentic Resource Consumption"@en ;
	rdfs:comment "Adversaries may coerce an agentic AI system into performing computationally expensive tool calls that waste resources and consume API budgets. They may utilize LLM Prompt Injection or AI Agent Tool Data Poisoning with directives that push the agent to perform unnecessary API queries, excessive query fan-outs, or many distinct tool calls. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0034.002" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0035
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Artifact Collection"@en ;
	rdfs:comment "Adversaries may collect AI artifacts for Exfiltration or for use in AI Attack Staging. AI artifacts include models and datasets as well as other telemetry data produced when interacting with a model. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0035" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0036
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data from Information Repositories"@en ;
	rdfs:comment "Adversaries may leverage information repositories to mine valuable information. Information repositories are tools that allow for storage of information, typically to facilitate collaboration or information sharing between users, and can store a wide variety of data that may aid adversaries in further objectives, or direct access to the target information. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0036" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213> ;
	.

atlas:AML.T0037
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data from Local System"@en ;
	rdfs:comment "Adversaries may search local system sources, such as file systems and configuration files or local databases, to find files of interest and sensitive data prior to Exfiltration. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0037" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1005> ;
	.

atlas:AML.T0040
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Model Inference API Access"@en ;
	rdfs:comment "Adversaries may gain access to a model via legitimate access to the inference API. Inference API access can be a source of information to the adversary (Discover AI Model Ontology, Discover AI Model Family), a means of staging the attack (Verify Attack, Craft Adversarial Data), or for introducing data to the target system for Impact (Evade AI Model, Erode AI Model Integrity). ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0040" ;
	dcterms:subject atlas-tactic:AML.TA0000 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0041
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Physical Environment Access"@en ;
	rdfs:comment "In addition to the attacks that take place purely in the digital domain, adversaries may also exploit the physical environment for their attacks. If the model is interacting with data collected from the real world in some way, the adversary can influence the model through access to wherever the data is being collected. By modifying the data in the collection process, the adversary can perform modified versions of attacks designed for digital access. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0041" ;
	dcterms:subject atlas-tactic:AML.TA0000 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0042
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Verify Attack"@en ;
	rdfs:comment "Adversaries can verify the efficacy of their attack via an inference API or access to an offline copy of the target model. This gives the adversary confidence that their approach works and allows them to carry out the attack at a later time of their choosing. The adversary may verify the attack once but use it against many edge devices running copies of the target model. The adversary may verify their attack digitally, then deploy it in the Physical Environment Access at a later time. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0042" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Craft Adversarial Data"@en ;
	rdfs:comment "Adversarial data are inputs to an AI model that have been modified such that they cause the adversary's desired effect in the target model. Effects can range from misclassification, to missed detections, to maximizing energy consumption. Typically, the modification is constrained in magnitude or location so that a human still perceives the data as if it were unmodified, but human perceptibility may not always be a concern depending on the adversary's intended effect. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0043" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0043 ;
	rdfs:label "Craft Adversarial Data: White-Box Optimization"@en ;
	rdfs:comment "In White-Box Optimization, the adversary has full access to the target model and optimizes the adversarial example directly. Adversarial examples trained in this manner are most effective against the target model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0043.000" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0043 ;
	rdfs:label "Craft Adversarial Data: Black-Box Optimization"@en ;
	rdfs:comment "In Black-Box attacks, the adversary has black-box (i.e. AI Model Inference API Access via API access) access to the target model. With black-box attacks, the adversary may be using an API that the victim is monitoring. These attacks are generally less effective and require more inferences than White-Box Optimization attacks, but they require much less access. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0043.001" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0043 ;
	rdfs:label "Craft Adversarial Data: Black-Box Transfer"@en ;
	rdfs:comment "In Black-Box Transfer attacks, the adversary uses one or more proxy models (trained via Create Proxy AI Model or Train Proxy via Replication) they have full access to and are representative of the target model. The adversary uses White-Box Optimization on the proxy models to generate adversarial examples. If the set of proxy models are close enough to the target model, the adversarial example should generalize from one to another. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0043.002" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0043 ;
	rdfs:label "Craft Adversarial Data: Manual Modification"@en ;
	rdfs:comment "Adversaries may manually modify the input data to craft adversarial data. They may use their knowledge of the target model to modify parts of the data they suspect helps the model in performing its task. The adversary may use trial and error until they are able to verify they have a working adversarial input. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0043.003" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0043.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0043 ;
	rdfs:label "Craft Adversarial Data: Insert Backdoor Trigger"@en ;
	rdfs:comment "The adversary may add a perceptual trigger into inference data. The trigger may be imperceptible or non-obvious to humans. This technique is used in conjunction with Poison AI Model and allows the adversary to produce their desired effect in the target model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0043.004" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0044
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Full AI Model Access"@en ;
	rdfs:comment "Adversaries may gain full \"white-box\" access to an AI model. This means the adversary has complete knowledge of the model architecture, its parameters, and class ontology. They may exfiltrate the model to Craft Adversarial Data and Verify Attack in an offline environment where it is hard to detect their behavior. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0044" ;
	dcterms:subject atlas-tactic:AML.TA0000 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0046
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Spamming AI System with Chaff Data"@en ;
	rdfs:comment "Adversaries may spam the AI system with chaff data that causes increase in the number of detections. This can cause analysts at the victim organization to waste time reviewing and correcting incorrect inferences. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0046" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0047
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI-Enabled Product or Service"@en ;
	rdfs:comment "Adversaries may use a product or service that uses artificial intelligence under the hood to gain access to the underlying AI model. This type of indirect model access may reveal details of the AI model or its inferences in logs or metadata. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0047" ;
	dcterms:subject atlas-tactic:AML.TA0000 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "External Harms"@en ;
	rdfs:comment "Adversaries may abuse their access to a victim system and use its resources or capabilities to further their goals by causing harms external to that system. These harms could affect the organization (e.g. Financial Harm, Reputational Harm), its users (e.g. User Harm), or the general public (e.g. Societal Harm). ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0048" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0048 ;
	rdfs:label "External Harms: Financial Harm"@en ;
	rdfs:comment "Financial harm involves the loss of wealth, property, or other monetary assets due to theft, fraud or forgery, or pressure to provide financial resources to the adversary. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0048.000" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0048 ;
	rdfs:label "External Harms: Reputational Harm"@en ;
	rdfs:comment "Reputational harm involves a degradation of public perception and trust in organizations. Examples of reputation-harming incidents include scandals or false impersonations. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0048.001" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0048 ;
	rdfs:label "External Harms: Societal Harm"@en ;
	rdfs:comment "Societal harms might generate harmful outcomes that reach either the general public or specific vulnerable groups such as the exposure of children to vulgar content. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0048.002" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0048 ;
	rdfs:label "External Harms: User Harm"@en ;
	rdfs:comment "User harms may encompass a variety of harm types including financial and reputational that are directed at or felt by individual victims of the attack rather than at the organization level. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0048.003" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0048.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0048 ;
	rdfs:label "External Harms: AI Intellectual Property Theft"@en ;
	rdfs:comment "Adversaries may exfiltrate AI artifacts to steal intellectual property and cause economic harm to the victim organization. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0048.004" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0049
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploit Public-Facing Application"@en ;
	rdfs:comment "Adversaries may attempt to take advantage of a weakness in an Internet-facing computer or program using software, data, or commands in order to cause unintended or unanticipated behavior. The weakness in the system can be a bug, a glitch, or a design vulnerability. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0049" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1190> ;
	.

atlas:AML.T0050
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Command and Scripting Interpreter"@en ;
	rdfs:comment "Adversaries may abuse command and script interpreters to execute commands, scripts, or binaries. These interfaces and languages provide ways of interacting with computer systems and are a common feature across many different platforms. Most systems come with some built-in command-line interface and scripting capabilities, for example, macOS and Linux distributions include some flavor of Unix Shell while Windows installations include the Windows Command Shell and PowerShell. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0050" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059> ;
	.

atlas:AML.T0051
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Prompt Injection"@en ;
	rdfs:comment "An adversary may craft malicious prompts as inputs to an LLM that cause the LLM to act in unintended ways. These \"prompt injections\" are often designed to cause the model to ignore aspects of its original instructions and follow the adversary's instructions instead. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0051" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0051.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0051 ;
	rdfs:label "LLM Prompt Injection: Direct"@en ;
	rdfs:comment "An adversary may inject prompts directly as a user of the LLM. This type of injection may be used by the adversary to gain a foothold in the system or to misuse the LLM itself, as for example to generate harmful content. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0051.000" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0051.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0051 ;
	rdfs:label "LLM Prompt Injection: Indirect"@en ;
	rdfs:comment "An adversary may inject prompts indirectly via a separate data channel that the LLM or AI agent ingests, such as text or multimedia pulled from documents, emails, databases or websites. These instructions originate from adversary-controlled content rather than the legitimate user, and are frequently hidden or obfuscated (See LLM Prompt Obfuscation) from the user, for example as invisible text. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0051.001" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0051.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0051 ;
	rdfs:label "LLM Prompt Injection: Triggered"@en ;
	rdfs:comment "An adversary may trigger a prompt injection via a user action or event that occurs within the victim's environment. Triggered prompt injections often target AI agents, which can be activated by means the adversary identifies during Discovery (See Activation Triggers). These malicious prompts may be hidden or obfuscated from the user and may already exist somewhere in the victim's environment from the adversary performing Prompt Infiltration via Public-Facing Application. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0051.002" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0052
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Phishing"@en ;
	rdfs:comment "Adversaries may send phishing messages to gain access to victim systems. All forms of phishing are electronically delivered social engineering. Phishing can be targeted, known as spearphishing. In spearphishing, a specific individual, company, or industry will be targeted by the adversary. More generally, adversaries can conduct non-targeted phishing, such as in mass malware spam campaigns. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0052" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1566> ;
	.

atlas:AML.T0052.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0052 ;
	rdfs:label "Phishing: Spearphishing via Social Engineering LLM"@en ;
	rdfs:comment "Adversaries may turn LLMs into targeted social engineers. LLMs are capable of interacting with users via text conversations. They can be instructed by an adversary to seek sensitive information from a user and act as effective social engineers. They can be targeted towards particular personas defined by the adversary. This allows adversaries to scale spearphishing efforts and target individuals to reveal private information such as credentials to privileged systems. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0052.000" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0052.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0052 ;
	rdfs:label "Phishing: Deepfake-Assisted Phishing"@en ;
	rdfs:comment "Adversaries may use deepfakes (AI-generated synthetic images, audio, or video) in phishing campaigns to impersonate trusted individuals, executives, or organizations. These attacks exploit human trust by presenting fraudulent voice or video communications as legitimate, enabling adversaries to manipulate targets into disclosing credentials, transferring funds, or granting access to systems. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0052.001" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0053
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Tool Invocation"@en ;
	rdfs:comment "Adversaries may use their access to an AI agent to invoke tools the agent has access to. LLMs are often connected to other services or resources via tools to increase their capabilities. Tools may include integrations with other applications, access to public or private data sources, and the ability to execute code. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0053" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:subject atlas-tactic:AML.TA0012 ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0054
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Jailbreak"@en ;
	rdfs:comment "Adversaries may induce a large language model (LLM) to ignore, circumvent, or override its safety/alignment behaviors and/or guardrails to elicit outputs the model is intended to withhold. Once jailbroken, the LLM may be used in unintended ways by the adversary. Jailbreaks may be achieved via adversarial prompting, or by modifying model weights or safety mechanisms. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0054" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:subject atlas-tactic:AML.TA0012 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0055
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Unsecured Credentials"@en ;
	rdfs:comment "Adversaries may search compromised systems to find and obtain insecurely stored credentials. These credentials can be stored and/or misplaced in many locations on a system, including plaintext files (e.g. bash history), environment variables, operating system, or application-specific repositories (e.g. Credentials in Registry), or other specialized files/artifacts (e.g. private keys). ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0055" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1552> ;
	.

atlas:AML.T0056
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Extract LLM System Prompt"@en ;
	rdfs:comment "Adversaries may attempt to extract a large language model's (LLM) system prompt. Adversaries achieve this via prompt injection that induces the model to reveal its system prompt, or they may extract it from a configuration file. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0056" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0057
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Data Leakage"@en ;
	rdfs:comment "Adversaries may craft prompts that induce the LLM to leak sensitive information. This can include private user data or proprietary information. The leaked information may come from proprietary training data, data sources the LLM is connected to, or information from other users of the LLM. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0057" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0059
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Erode Dataset Integrity"@en ;
	rdfs:comment "Adversaries may poison or manipulate portions of a dataset to reduce its usefulness, reduce trust, and cause users to waste resources correcting errors. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0059" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0060
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Publish Hallucinated Entities"@en ;
	rdfs:comment "Adversaries may create an entity they control, such as a software package, website, or email address corresponding to a source hallucinated by an LLM. The hallucinations may take the form of package names, commands, URLs, company names, or email addresses that point the victim to the entity controlled by the adversary. When the victim interacts with the adversary-controlled entity, the attack can proceed. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0060" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0061
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Prompt Self-Replication"@en ;
	rdfs:comment "An adversary may use a carefully crafted LLM Prompt Injection designed to cause the LLM to replicate the prompt as part of its output. This allows the prompt to propagate to other LLMs and persist on the system. The self-replicating prompt is typically paired with other malicious instructions (ex: LLM Jailbreak, LLM Data Leakage). ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0061" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0062
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover LLM Hallucinations"@en ;
	rdfs:comment "Adversaries may prompt large language models and identify hallucinated entities. They may request software packages, commands, URLs, organization names, or e-mail addresses, and identify hallucinations with no connected real-world source. Discovered hallucinations provide the adversary with potential targets to Publish Hallucinated Entities. Different LLMs have been shown to produce the same hallucinations, so the hallucinations exploited by an adversary may affect users of other LLMs. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0062" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0063
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Model Outputs"@en ;
	rdfs:comment "Adversaries may discover model outputs, such as class scores, whose presence is not required for the system to function and are not intended for use by the end user. Model outputs may be found in logs or may be included in API responses. Model outputs may enable the adversary to identify weaknesses in the model and develop attacks. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0063" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0064
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Gather RAG-Indexed Targets"@en ;
	rdfs:comment "Adversaries may identify data sources used in retrieval augmented generation (RAG) systems for targeting purposes. By pinpointing these sources, attackers can focus on poisoning or otherwise manipulating the external data repositories the AI relies on. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0064" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0065
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Prompt Crafting"@en ;
	rdfs:comment "Adversaries may use their acquired knowledge of the target generative AI system to craft prompts that bypass its defenses and allow malicious instructions to be executed. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0065" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0066
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Retrieval Content Crafting"@en ;
	rdfs:comment "Adversaries may write content designed to be retrieved by user queries and influence a user of the system in some way. This abuses the trust the user has in the system. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0066" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0067
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Trusted Output Components Manipulation"@en ;
	rdfs:comment "Adversaries may utilize prompts to a large language model (LLM) which manipulate various components of its response in order to make it appear trustworthy to the user. This helps the adversary continue to operate in the victim's environment and evade detection by the users it interacts with. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0067" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0067.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0067 ;
	rdfs:label "LLM Trusted Output Components Manipulation: Citations"@en ;
	rdfs:comment "Adversaries may manipulate the citations provided in an AI system's response, in order to make it appear trustworthy. Variants include providing the wrong citation, making up a new citation, or providing the right citation but for adversary-provided data. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0067.000" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0068
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Prompt Obfuscation"@en ;
	rdfs:comment "Adversaries may hide or otherwise obfuscate prompt injections or retrieval content to avoid detection from humans, large language model (LLM) guardrails, or other detection mechanisms. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0068" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0069
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover LLM System Information"@en ;
	rdfs:comment "The adversary is trying to discover something about the large language model's (LLM) system information. This may be found in a configuration file containing the system instructions or extracted via interactions with the LLM. The desired information may include the full system prompt, special characters that have significance to the LLM or keywords indicating functionality available to the LLM. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0069" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0069.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0069 ;
	rdfs:label "Discover LLM System Information: Special Character Sets"@en ;
	rdfs:comment "Adversaries may discover delimiters and special characters sets used by the large language model. For example, delimiters used in retrieval augmented generation applications to differentiate between context and user prompts. These can later be exploited to confuse or manipulate the large language model into misbehaving. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0069.000" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0069.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0069 ;
	rdfs:label "Discover LLM System Information: System Instruction Keywords"@en ;
	rdfs:comment "Adversaries may discover keywords that have special meaning to the large language model (LLM), such as function names or object names. These can later be exploited to confuse or manipulate the LLM into misbehaving and to make calls to plugins the LLM has access to. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0069.001" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0069.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0069 ;
	rdfs:label "Discover LLM System Information: System Prompt"@en ;
	rdfs:comment "Adversaries may discover a large language model's system instructions provided by the AI system builder to learn about the system's capabilities and circumvent its guardrails. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0069.002" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0070
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "RAG Poisoning"@en ;
	rdfs:comment "Adversaries may inject malicious content into data indexed by a retrieval augmented generation (RAG) system to contaminate a future thread through RAG-based search results. This may be accomplished by placing manipulated documents in a location the RAG indexes (see Gather RAG-Indexed Targets). ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0070" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0071
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "False RAG Entry Injection"@en ;
	rdfs:comment "Adversaries may introduce false entries into a victim's retrieval augmented generation (RAG) database. Content designed to be interpreted as a document by the large language model (LLM) used in the RAG system is included in a data source being ingested into the RAG database. When a RAG entry containing the false document is retrieved, the LLM is tricked into treating part of the retrieved content as a false RAG result. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0071" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0072
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Cyber Communication Channel"@en ;
	rdfs:comment "Adversaries may establish or use cyber communication channels for command and control. A channel may use any network protocol, service, repository, relay, or other intermediary and may operate synchronously or asynchronously. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0072" ;
	dcterms:subject atlas-tactic:AML.TA0014 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0073
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Impersonation"@en ;
	rdfs:comment "Adversaries may impersonate a trusted person or organization in order to persuade and trick a target into performing some action on their behalf. For example, adversaries may communicate with victims (via Phishing, or Spearphishing via Social Engineering LLM) while impersonating a known sender such as an executive, colleague, or third-party vendor. Established trust can then be leveraged to accomplish an adversary's ultimate goals, possibly against multiple victims. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0073" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1656> ;
	.

atlas:AML.T0074
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Masquerading"@en ;
	rdfs:comment "Adversaries may attempt to manipulate features of their artifacts to make them appear legitimate or benign to users and/or security tools. Masquerading occurs when the name or location of an object, legitimate or malicious, is manipulated or abused for the sake of evading defenses and observation. This may include manipulating file metadata, tricking users into misidentifying the file type, and giving legitimate task or service names. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0074" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1036> ;
	.

atlas:AML.T0075
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Enterprise Resource Discovery"@en ;
	rdfs:comment "Adversaries may discover resources available within an enterprise environment and information needed to identify or access them. Resources may include accounts, groups, systems, devices, virtual machines, files, directories, storage volumes, cloud objects, containers, applications, software, processes, services, network shares, repositories, policies, logs, and other local, remote, or cloud-hosted assets. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0075" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0076
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Corrupt AI Model"@en ;
	rdfs:comment "An adversary may purposefully corrupt a malicious AI model file so that it cannot be successfully deserialized in order to evade detection by a model scanner. The corrupt model may still successfully execute malicious code before deserialization fails. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0076" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0077
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "LLM Response Rendering"@en ;
	rdfs:comment "Adversaries may induce a large language model (LLM) to respond with private information structured in a reference to external content that, when rendered by the user's client, makes a request to an adversary-controlled server, exfiltrating the data. The private information can be hidden from the user and the external content can still render properly in the user's client, thus not raising the suspicion of the user. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0077" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0078
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Drive-by Compromise"@en ;
	rdfs:comment "Adversaries may gain access to an AI system through a user visiting a website over the normal course of browsing, or an AI agent retrieving information from the web on behalf of a user. Websites can contain an LLM Prompt Injection which, when executed, can change the behavior of the AI model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0078" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1189> ;
	.

atlas:AML.T0079
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Stage Capabilities"@en ;
	rdfs:comment "Adversaries may upload, install, or otherwise set up capabilities that can be used during targeting. To support their operations, an adversary may need to take capabilities they developed (Develop Capabilities) or obtained (Obtain Capabilities) and stage them on infrastructure under their control. These capabilities may be staged on infrastructure that was previously purchased/rented by the adversary (Acquire Infrastructure) or was otherwise compromised by them. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0079" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0080
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Context Poisoning"@en ;
	rdfs:comment "Adversaries may attempt to manipulate the context used by an AI agent's large language model (LLM) to influence the responses it generates or actions it takes. This allows an adversary to persistently change the behavior of the target agent and further their goals. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0080" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0080.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0080 ;
	rdfs:label "AI Agent Context Poisoning: Memory"@en ;
	rdfs:comment "Adversaries may manipulate the memory of a large language model (LLM) in order to persist changes to the LLM across future chat sessions. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0080.000" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0080.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0080 ;
	rdfs:label "AI Agent Context Poisoning: Thread"@en ;
	rdfs:comment "Adversaries may introduce malicious instructions into a chat thread of a large language model (LLM) to cause behavior changes which persist for the remainder of the thread. A chat thread may continue for an extended period over multiple sessions. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0080.001" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0081
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Modify AI Agent Configuration"@en ;
	rdfs:comment "Adversaries may modify the configuration files for AI agents on a system. This allows malicious changes to persist beyond the life of a single agent and affects any agents that share the configuration. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0081" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0082
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "RAG Credential Harvesting"@en ;
	rdfs:comment "Adversaries may attempt to use their access to a large language model (LLM) on the victim's system to collect credentials. Credentials may be stored in internal documents which can inadvertently be ingested into a RAG database, where they can ultimately be retrieved by an AI agent. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0082" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0083
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Credentials from AI Agent Configuration"@en ;
	rdfs:comment "Adversaries may access the credentials of other tools or services on a system from the configuration of an AI agent. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0083" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0084
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Agent Configuration"@en ;
	rdfs:comment "Adversaries may attempt to discover configuration information for AI agents present on the victim's system. Agent configurations can include tools or services they have access to. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0084" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0084.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0084 ;
	rdfs:label "Discover AI Agent Configuration: Embedded Knowledge"@en ;
	rdfs:comment "Adversaries may attempt to discover the data sources a particular agent can access. The AI agent's configuration may reveal data sources or knowledge. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0084.000" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0084.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0084 ;
	rdfs:label "Discover AI Agent Configuration: Tool Definitions"@en ;
	rdfs:comment "Adversaries may discover the tools the AI agent has access to. By identifying which tools are available, the adversary can understand what actions may be executed through the agent and what additional resources it can reach. This knowledge may reveal access to external data sources such as OneDrive or SharePoint, or expose exfiltration paths like the ability to send emails, helping adversaries identify AI agents that provide the greatest value or opportunity for attack. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0084.001" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0084.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0084 ;
	rdfs:label "Discover AI Agent Configuration: Activation Triggers"@en ;
	rdfs:comment "Adversaries may discover keywords or other triggers (such as incoming emails, documents being added, incoming message, or other workflows) that activate an agent and may cause it to run additional actions. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0084.002" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0084.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0084 ;
	rdfs:label "Discover AI Agent Configuration: Call Chains"@en ;
	rdfs:comment "Adversaries may extract call chains from AI agent configurations, which can reveal potentially targets for remote code execution (RCE) or other vulnerabilities. Vulnerable call chains often connect user inputs or LLM outputs to an execution sink (e.g. exec, eval, os.popen). The vulnerabilities may be later exploited via LLM Prompt Injection. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0084.003" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0085
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data from AI Services"@en ;
	rdfs:comment "Adversaries may use their access to a victim organization's AI-enabled services to collect proprietary or otherwise sensitive information. As organizations adopt generative AI in centralized services for accessing an organization's data, such as with chat agents which can access retrieval augmented generation (RAG) databases and other data sources via tools, they become increasingly valuable targets for adversaries. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0085" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0085.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0085 ;
	rdfs:label "Data from AI Services: RAG Databases"@en ;
	rdfs:comment "Adversaries may prompt the AI service to retrieve data from a RAG database. This can include the majority of an organization's internal documents. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0085.000" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0085.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0085 ;
	rdfs:label "Data from AI Services: AI Agent Tools"@en ;
	rdfs:comment "Adversaries may prompt the AI service to invoke various tools the agent has access to. Tools may retrieve data from different APIs or services in an organization. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0085.001" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0086
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exfiltration via AI Agent Tool Invocation"@en ;
	rdfs:comment "AI agent tools capable of performing write operations may be invoked to exfiltrate data to an adversary. Sensitive information can be encoded into the tool's input parameters and transmitted to an adversary-controlled location (such as an inbox, document, or server) as part of a seemingly legitimate action. Variants include sending emails, creating or modifying documents, updating CRM records, or even generating media such as images or videos. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0086" ;
	dcterms:subject atlas-tactic:AML.TA0010 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0087
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Gather Victim Identity Information"@en ;
	rdfs:comment "Adversaries may gather information about the victim's identity that can be used during targeting. Information about identities may include a variety of details, including personal data (ex: employee names, email addresses, photos, etc.) as well as sensitive details such as credentials or multi-factor authentication (MFA) configurations. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0087" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1589> ;
	.

atlas:AML.T0088
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Generate Deepfakes"@en ;
	rdfs:comment "Adversaries may use generative artificial intelligence (GenAI) to create synthetic media (i.e. imagery, video, audio, and text) that appear authentic. These \"deepfakes\" may mimic a real person or depict fictional personas. Adversaries may use deepfakes for impersonation to conduct Phishing or to evade AI applications such as biometric identity verification systems (see Evade AI Model). ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0088" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0089
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Enterprise Environment Discovery"@en ;
	rdfs:comment "Adversaries may discover configurations, conditions, relationships, activity, and other characteristics of an enterprise environment. This may include system and network configuration; active connections, processes, windows, and users; permissions, trust relationships, and policy settings; installed defensive or backup capabilities; network traffic; browser and registry information; or environmental properties such as location, language, time, connectivity, virtualization, debugging, and sandbo… ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0089" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0090
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "OS Credential Dumping"@en ;
	rdfs:comment "Adversaries may extract credentials from OS caches, application memory, or other sources on a compromised system. Credentials are often in the form of a hash or clear text, and can include usernames and passwords, application tokens, or other authentication keys. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0090" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1003> ;
	.

atlas:AML.T0091
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Use Alternate Authentication Material"@en ;
	rdfs:comment "Adversaries may use alternate authentication material, such as password hashes, Kerberos tickets, and application access tokens, in order to move laterally within an environment and bypass normal system access controls. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0091" ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1550> ;
	.

atlas:AML.T0091.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0091 ;
	rdfs:label "Use Alternate Authentication Material: Application Access Token"@en ;
	rdfs:comment "Adversaries may use stolen application access tokens to bypass the typical authentication process and access restricted accounts, information, or services on remote systems. These tokens are typically stolen from users or services and used in lieu of login credentials. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0091.000" ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1550.001> ;
	.

atlas:AML.T0091.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0091 ;
	rdfs:label "Use Alternate Authentication Material: Web Session Cookie"@en ;
	rdfs:comment "Adversaries may use stolen web session cookies to authenticate to AI-enabled applications and supporting services as another user. This technique may bypass some multi-factor authentication controls because the session represented by the cookie has already been authenticated. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0091.001" ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-06-30"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1550.004> ;
	.

atlas:AML.T0092
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Manipulate User LLM Chat History"@en ;
	rdfs:comment "Adversaries may manipulate a user's large language model (LLM) chat history to cover the tracks of their malicious behavior. They may hide persistent changes they have made to the LLM's behavior, or obscure their attempts at discovering private information about the user. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0092" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0093
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Prompt Infiltration via Public-Facing Application"@en ;
	rdfs:comment "An adversary may introduce malicious prompts into the victim's system via a public-facing application with the intention of it being ingested by an AI at some point in the future and ultimately having a downstream effect. This may occur when a data source is indexed by a retrieval augmented generation (RAG) system, when a rule triggers an action by an AI agent, or when a user utilizes a large language model (LLM) to interact with the malicious content. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0093" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0094
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Delay Execution of LLM Instructions"@en ;
	rdfs:comment "Adversaries may include instructions to be followed by the AI system in response to a future event, such as a specific keyword or the next interaction, in order to evade detection or bypass controls placed on the AI system. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0094" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0095
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Search Open Websites/Domains"@en ;
	rdfs:comment "Adversaries may search public websites and/or domains for information about victims and AI targets that can be used during targeting and to discover opportunities for successful attacks. Information about a victim's attack surface may be available in various online sites, such as social media, news sites, or domains owned by the victim. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0095" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1593> ;
	.

atlas:AML.T0095.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0095 ;
	rdfs:label "Search Open Websites/Domains: Code Repositories"@en ;
	rdfs:comment "Adversaries may search public code repositories for information about a victim or victim system that can be used during targeting. Victims may store code or artifacts related to their AI systems in repositories on various third-party websites such as GitHub, GitLab, SourceForge, and BitBucket. Adversaries may search code repositories of common AI tools, frameworks, models, or agentic systems that are used--but not owned--by the victim. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0095.000" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1593.003> ;
	.

atlas:AML.T0096
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Service API"@en ;
	rdfs:comment "Adversaries may communicate using the API of an AI service on the victim's system. The adversary's commands to the victim system, and often the results, are embedded in the normal traffic of the AI service. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0096" ;
	dcterms:subject atlas-tactic:AML.TA0014 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0097
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Virtualization/Sandbox Evasion"@en ;
	rdfs:comment "Adversaries may employ various means to detect and avoid virtualization and analysis environments. This may include changing behaviors based on the results of checks for the presence of artifacts indicative of a virtual machine environment (VME) or sandbox. If the adversary detects a VME, they may alter their malware to disengage from the victim or conceal the core functions of the implant. They may also search for VME artifacts before dropping secondary or additional payloads. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0097" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1497> ;
	.

atlas:AML.T0098
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Tool Credential Harvesting"@en ;
	rdfs:comment "Adversaries may attempt to use their access to an AI agent on the victim's system to retrieve data from available agent tools to collect credentials. Agent tools may connect to a wide range of sources that may contain credentials including document stores (e.g. SharePoint, OneDrive or Google Drive), code repositories (e.g. GitHub or GitLab), or enterprise productivity tools (e.g. as email providers or Slack), and local notetaking tools (e.g. Obsidian or Apple Notes). ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0098" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0099
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Tool Data Poisoning"@en ;
	rdfs:comment "Adversaries may manipulate data in a victim-controlled, trusted, or connected data source that is accessible through an AI agent tool. Poisoned data may be placed in document repositories, databases, source-code repositories, knowledge bases, search indexes, enterprise applications, or third-party data services used by the agent. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0099" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0100
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Clickbait"@en ;
	rdfs:comment "Adversaries may craft deceptive content designed to bait computer-using AI agents or AI web browsers and tools into taking unintended actions, such as clicking buttons, copying code, or navigating to specific web pages. These attacks exploit the agent's interpretation of UI content, visual cues, and natural language embedded in processed artifacts, such as a website or a document, and aim at the agent's decision process rather than a human reader's. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0100" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0101
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data Destruction via AI Agent Tool Invocation"@en ;
	rdfs:comment "Adversaries may invoke an AI agent's tool capable of performing mutative operations to perform Data Destruction. Adversaries may destroy data and files on specific systems or in large numbers on a network to interrupt availability to systems, services, and network resources. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0101" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0102
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Generate Malicious Commands"@en ;
	rdfs:comment "Adversaries may use large language models (LLMs) to dynamically generate malicious commands from natural language. Dynamically generated commands may be harder to detect as the attack signature is constantly changing. AI-generated commands may also allow adversaries to more rapidly adapt to different environments and adjust their tactics. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0102" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0103
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Deploy AI Agent"@en ;
	rdfs:comment "Adversaries may launch AI agents in the victim's environment to execute actions on their behalf. AI agents may have access to a wide range of tools and data sources, as well as permissions to access and interact with other services and systems in the victim's environment. The adversary may leverage these capabilities to carry out their operations. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0103" ;
	dcterms:subject atlas-tactic:AML.TA0005 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0105
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Escape to Host"@en ;
	rdfs:comment "Adversaries may break out of a container or virtualized environment to gain access to the underlying host. This can allow an adversary access to other containerized or virtualized resources from the host level or to the host itself. In principle, containerized / virtualized resources should provide a clear separation of application functionality and be isolated from the host environment. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0105" ;
	dcterms:subject atlas-tactic:AML.TA0012 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1611> ;
	.

atlas:AML.T0106
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Credential Access"@en ;
	rdfs:comment "Adversaries may exploit software vulnerabilities in an attempt to collect credentials. Exploitation of a software vulnerability occurs when an adversary takes advantage of a programming error in a program, service, or within the operating system software or kernel itself to execute adversary-controlled code. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0106" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1211> ;
	.

atlas:AML.T0107
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Defense Evasion"@en ;
	rdfs:comment "Adversaries may exploit a system or application vulnerability to bypass security features. Exploitation of a vulnerability occurs when an adversary takes advantage of a programming error in a program, service, or within the operating system software or kernel itself to execute adversary-controlled code. Vulnerabilities may exist in defensive security software that can be used to disable or circumvent them. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0107" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1211> ;
	.

atlas:AML.T0108
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent"@en ;
	rdfs:comment "Adversaries may abuse AI agents present on the victim's system for command and control. AI agents are often granted access to tools that can execute shell commands, reach out to the internet, and interact with other services in the victim's environment, making them capable C2 agents. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0108" ;
	dcterms:subject atlas-tactic:AML.TA0014 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0109
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Supply Chain Rug Pull"@en ;
	rdfs:comment "Adversaries may publish legitimate AI components or software, gain user adoption, then push an update with a malicious variant, leading to AI Supply Chain Compromise. More scrutiny is often placed on a supply chain dependency when it is first being considered for inclusion in an AI system. Performing a rug pull may allow adversaries to bypass these defenses and be more likely to achieve Initial Access. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0109" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0110
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Tool Poisoning"@en ;
	rdfs:comment "Adversaries may poison tools used by AI agents by introducing or modifying malicious content or behavior in a tool's model-visible definition, executable implementation, or runtime responses. Tools may include built-in integrations, locally installed packages, remotely hosted services, Model Context Protocol (MCP) servers and tools, and agent skills or similar capability packages. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0110" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0110.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0110 ;
	rdfs:label "AI Agent Tool Poisoning: Definition and Instructions"@en ;
	rdfs:comment "Adversaries may poison the model-visible definition or operational instructions of an AI agent tool to manipulate how an agent interprets, selects, or invokes the tool. The poisoned content may be contained in tool descriptions, docstrings, parameter names, help text, input or output schemas, annotations, examples, manifests, skill instruction files, or other static content used to explain a tool's capabilities to the model. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0110.000" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0110.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0110 ;
	rdfs:label "AI Agent Tool Poisoning: Implementation"@en ;
	rdfs:comment "Adversaries may poison the executable implementation of an AI agent tool so that normal tool invocation produces unauthorized behavior or hidden side effects. The tool may continue to provide its represented functionality while also accessing additional data, modifying requests, changing recipients or destinations, executing unauthorized commands, weakening security controls, or performing covert data exfiltration. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0110.001" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0110.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0110 ;
	rdfs:label "AI Agent Tool Poisoning: Runtime Response"@en ;
	rdfs:comment "Adversaries may poison the runtime response channel of a malicious or compromised AI agent tool by deliberately returning content intended to influence the model's subsequent reasoning, decisions, or actions. Poisoned responses may contain malicious instructions, deceptive data, fabricated errors, embedded resources, or other content designed to be treated as trusted context after an approved tool invocation. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0110.002" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0111
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Supply Chain Reputation Inflation"@en ;
	rdfs:comment "AI Supply Chain Reputation Inflation is the process of building or leveraging genuinely credible-looking trust signals to increase the perceived legitimacy of AI supply chain components, with the goal of driving adoption of malicious or compromised assets. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0111" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0112
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Machine Compromise"@en ;
	rdfs:comment "Adversaries may compromise a machine by exploiting or manipulating AI-enabled components on the system. Compromising a victim system allows the adversary to execute arbitrary code, steal credentials, exfiltrate data, and continue to persist on the system. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0112" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0112.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0112 ;
	rdfs:label "Machine Compromise: Local AI Agent"@en ;
	rdfs:comment "Adversaries may achieve full system compromise by abusing AI agents running locally on a host, such as computer-use agents or AI-driven browsers. These agents are designed to autonomously interact with the operating system, applications, and external services, often with broad permissions to execute commands, access files, manage credentials, and control user workflows. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0112.000" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0112.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0112 ;
	rdfs:label "Machine Compromise: AI Artifacts"@en ;
	rdfs:comment "Adversaries may achieve full system compromise by introducing malicious AI artifacts, such as models or data, that contain embedded malware or other malicious commands. AI artifacts are often stored in model registries or data stores and may affect many systems that pull these resources. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0112.001" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-05-27"^^xsd:date ;
	.

atlas:AML.T0113
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Steal Web Session Cookie"@en ;
	rdfs:comment "Adversaries may steal web application or service session cookies used to authenticate users to AI-enabled systems, AI services, or supporting enterprise applications. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0113" ;
	dcterms:subject atlas-tactic:AML.TA0013 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-06-30"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1539> ;
	.

atlas:AML.T0114
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Service Web Interface"@en ;
	rdfs:comment "Adversaries may communicate with compromised systems by abusing the web interface of an AI service as an intermediary command-and-control relay. Instead of connecting directly to attacker-controlled infrastructure or using an AI provider's API, malware may open or automate a browser, embedded browser, or WebView component to interact with a public AI assistant. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0114" ;
	dcterms:subject atlas-tactic:AML.TA0014 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-06-30"^^xsd:date ;
	.

atlas:AML.T0115
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Publish Poisoned AI Artifacts"@en ;
	rdfs:comment "Adversaries may create or modify AI artifacts and publish them through public or shared distribution channels to facilitate compromise of downstream AI systems. Poisoned AI artifacts may include datasets, models, and AI agent tools containing malicious content, behaviors, code, or configurations. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0115" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0115.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0115 ;
	rdfs:label "Publish Poisoned AI Artifacts: Datasets"@en ;
	rdfs:comment "Adversaries may publish poisoned datasets intended for training or fine-tuning AI models. The dataset may be newly created or a modified variant of a legitimate dataset and may contain manipulated samples, labels, annotations, or metadata. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0115.000" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0115.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0115 ;
	rdfs:label "Publish Poisoned AI Artifacts: Models"@en ;
	rdfs:comment "Adversaries may publish poisoned AI models through model registries, code repositories, or other model distribution channels. The model may be newly created or a modified variant of a legitimate model and may contain manipulated weights, configurations, architecture, serialized code, or other components that produce malicious behavior or execute malicious code. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0115.001" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0115.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0115 ;
	rdfs:label "Publish Poisoned AI Artifacts: AI Agent Tools"@en ;
	rdfs:comment "Adversaries may create and publish poisoned AI agent tools. Poisoned tools may contain malicious model-visible definitions or instructions, hidden executable behavior, or runtime responses designed to manipulate an AI agent. Tools may be published through source code repositories, package registries, agent tool or skill registries, or adversary-controlled remote services. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0115.002" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-07-31"^^xsd:date ;
	.

atlas:AML.T0116
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Autonomous Reconnaissance"@en ;
	rdfs:comment "Adversaries may use autonomous AI agents to conduct Reconnaissance activities. Given an objective, target, or partial lead, an agent may autonomously determine what information to obtain and how to investigate it. It may interpret observations, identify gaps in its understanding of the externally observable attack surface, and select subsequent reconnaissance actions without a human specifying each investigative step. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0116" ;
	dcterms:subject atlas-tactic:AML.TA0002 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0117
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Autonomous Attack-Path Adaptation"@en ;
	rdfs:comment "Adversaries may use an AI agent to autonomously construct and repeatedly revise an attack path toward an adversary-defined objective. Given a high-level objective, the system may derive intermediate objectives, identify prerequisites, and compare candidate paths, and incorporate observations from previous actions to adaptively sequence techniques without a human directing each step. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0117" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0118
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Autonomous AI Agent Communication"@en ;
	rdfs:comment "Autonomous AI agents may exchange operational information with other AI agents, sub-agents, or independent agent runs. Exchanged information may include discoveries, objectives, tasking, capabilities, credentials, constraints, operating rules, task state, targeting information, instructions, or results. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0118" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0118.000
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0118 ;
	rdfs:label "Autonomous AI Agent Communication: Communication via Shared Artifacts"@en ;
	rdfs:comment "Autonomous AI agents may communicate by creating or modifying artifacts in a shared resource that persists outside their individual execution contexts. Shared artifacts may convey discoveries, objectives, tasking, credentials, capabilities, operating rules, progress, scripts, targeting information, instructions, or results. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0118.000" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0118.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf atlas:AML.T0118 ;
	rdfs:label "Autonomous AI Agent Communication: Direct Agent Communication"@en ;
	rdfs:comment "Autonomous AI agents may communicate directly through agent-to-agent, sub-agent, or orchestrator interfaces. An agent may provide another agent with operational context, discoveries, objectives, tasking, capabilities, credentials, or constraints, and may receive status, findings, or completed work in response. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0118.001" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0119
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploit Automated Artifact Processing Pipeline"@en ;
	rdfs:comment "Adversaries may submit, publish, or modify an artifact in a way that triggers an automated processing pipeline. As the pipeline handles the artifact, adversary-controlled content or configuration may exploit a weakness in the processing logic, causing the processor to act outside its intended behavior using the permissions and access of a processing worker. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0119" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0120
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Artifact Repository"@en ;
	rdfs:comment "Adversaries may repurpose AI artifact repositories as asynchronous command-and-control channels. Commands, payloads, or tasking may be placed in repository objects for a compromised system to retrieve or poll. The compromised system may then write execution results, status, or collected information back to the repository for retrieval by the adversary. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0120" ;
	dcterms:subject atlas-tactic:AML.TA0014 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0121
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Environment Reconstruction"@en ;
	rdfs:comment "An autonomous AI agent may reconstruct the environment needed to continue an existing operation after its execution environment is lost, reset, replaced, denied, or made unusable. The agent may recover or recreate tools, dependencies, configuration, credentials or access paths, communication or coordination resources, working artifacts, and externally stored operational state in order to resume the same objective. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0121" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0122
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation of Remote Services"@en ;
	rdfs:comment "Adversaries may exploit a software or design weakness in a service reachable from their current environment to gain unauthorized access to another system, component, network, or trust boundary. Exploitation may allow the adversary to execute code, access protected resources, invoke unauthorized operations, obtain the service's privileges, or cause the service to make network requests or perform actions on the adversary's behalf. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0122" ;
	dcterms:subject atlas-tactic:AML.TA0015 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1210> ;
	.

atlas:AML.T0123
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Obfuscated Files or Information"@en ;
	rdfs:comment "Adversaries may attempt to make an executable or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the system or in transit. This is common behavior that can be used across different platforms and the network to evade defenses. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0123" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0124
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Autonomous Attack Orchestration"@en ;
	rdfs:comment "Adversaries may use autonomous AI systems as an operational control layer to manage multiple distinct autonomous agents or sub-agents toward a common adversary-defined objective. The orchestrating system may create assignments, select executors, allocate tools or resources, establish dependencies, schedule or synchronize activities, and track progress without a human directing each assignment. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0124" ;
	dcterms:subject atlas-tactic:AML.TA0001 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Enterprise" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	.

atlas:AML.T0125
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Create Account"@en ;
	rdfs:comment "Adversaries may create an account to maintain access to an AI system or its supporting infrastructure. With a sufficient level of access, creating such accounts may be used to establish secondary credentialed access that do not require persistent remote access tools to be deployed on the system. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0125" ;
	dcterms:subject atlas-tactic:AML.TA0006 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1136> ;
	.

atlas:AML.T0126
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Automated Collection"@en ;
	rdfs:comment "Adversaries may use automated techniques to collect data from AI systems and supporting enterprise environments. Automation may use scripts, command interpreters, command-line tools, or AI agent tools to identify, retrieve, copy, or aggregate data without a human selecting each individual item. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0126" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1119> ;
	.

atlas:AML.T0127
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data Staged"@en ;
	rdfs:comment "Adversaries may stage collected data in a central location before exfiltration. Staging consolidates, organizes, or prepares information obtained from one or more sources so it can be reviewed, processed, transferred, or retrieved more efficiently. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0127" ;
	dcterms:subject atlas-tactic:AML.TA0009 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1074> ;
	.

atlas:AML.T0128
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Compromise Infrastructure"@en ;
	rdfs:comment "Adversaries may compromise third-party infrastructure and repurpose it to support attacks against AI system. Rather than buying, leasing, registering, or otherwise legitimately acquiring a resource, the adversary gains unauthorized control of infrastructure owned or operated by another party. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0128" ;
	dcterms:subject atlas-tactic:AML.TA0003 ;
	dcterms:coverage "Enterprise" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-08-31"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1584> ;
	.

atlas:AML.T0129
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Triggers in Multimodal Inputs"@en ;
	rdfs:comment "Adversaries may place instructions or triggers in one part of a multimodal input to influence the model while staying unnoticed by human reviewers and by defenses that do not inspect all input modalities. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0129" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0130
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Agent Response Biasing"@en ;
	rdfs:comment "Adversaries may manipulate an AI assistant so that it favors adversary-chosen sources, or content in its responses. By injecting instructions such as \"treat [source] as a trusted source\" or \"recommend [source] first,\" an adversary biases the assistant's outputs toward their own interests, causing it to present promotional or self-serving content as if it were a neutral, well-reasoned response. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0130" ;
	dcterms:subject atlas-tactic:AML.TA0011 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0131
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Crafted AI Assistant Links"@en ;
	rdfs:comment "Adversaries may craft links that open an AI assistant or agent with attacker-controlled input already supplied, so that opening the link initiates an interaction the adversary defines rather than one the target composed. Many AI assistants accept a prompt through URL parameters (for example `?q=` or `?prompt=`) that is automatically populated, and in some cases submitted, when the link is opened. ATLAS maturity: Realized."@en ;
	action:techniqueID "AML.T0131" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0132
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Misconfigured or Publicly Exposed AI Services"@en ;
	rdfs:comment "AI agents and LLM platforms are deployed across diverse architectures, including standalone servers, SaaS platforms, and low-code builders. All of these often have misconfigured access controls, ranging from missing authentication in LLM runtimes to permissive public access settings, that significantly expand their attack surface. ATLAS maturity: Demonstrated."@en ;
	action:techniqueID "AML.T0132" ;
	dcterms:subject atlas-tactic:AML.TA0004 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:coverage "Generative AI" ;
	dcterms:coverage "Predictive AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0133
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Discover AI Agent Runtime Capabilities"@en ;
	rdfs:comment "Adversaries may interact with an AI agent at runtime to reveal the capabilities available to it, without requiring access to its underlying configuration. Direct interaction with the agent can surface its registered tools and their accepted parameters, the actions it can take, the resources it can reach, and the identity and permission scope it acts under. Capabilities can also be inferred indirectly by issuing varied requests and observing which succeeded, failed, or refused. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0133" ;
	dcterms:subject atlas-tactic:AML.TA0008 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.

atlas:AML.T0134
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "AI Targeted Cloaking"@en ;
	rdfs:comment "Adversaries may selectively deliver malicious or manipulated content to AI systems, while presenting different benign content to human users, web crawlers, or security detection mechanisms. They may identify AI browsers or agents via user-agent strings and condition the server response so that AI-based clients receive prompt injections or misleading content. ATLAS maturity: Feasible."@en ;
	action:techniqueID "AML.T0134" ;
	dcterms:subject atlas-tactic:AML.TA0007 ;
	dcterms:coverage "Agentic AI" ;
	dcterms:isPartOf <https://atlas.mitre.org/matrices/ATLAS> ;
	dcterms:modified "2026-09-15"^^xsd:date ;
	.
