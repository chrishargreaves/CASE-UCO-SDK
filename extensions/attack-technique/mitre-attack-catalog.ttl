	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Resource Hijacking"@en ;
	rdfs:comment "Adversaries may leverage the resources of co-opted systems to complete resource-intensive tasks, which may impact system and/or hosted service availability."@en ;
	action:techniqueID "T1496" ;
	dcterms:subject attack-tactic:TA0040 ;
