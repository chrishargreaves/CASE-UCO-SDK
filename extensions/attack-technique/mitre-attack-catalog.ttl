	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Network Connections Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of network connections to or from the compromised system they are currently accessing or from remote systems by querying for information over the network."@en ;
	action:techniqueID "T1049" ;
	dcterms:subject attack-tactic:TA0007 ;
