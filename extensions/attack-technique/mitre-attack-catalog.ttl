	dcterms:modified "2026-08-04"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1087/003> ;
	.

attack:T1087.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1087 ;
	rdfs:label "Account Discovery: Cloud Account"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of cloud accounts. Cloud accounts are those created and configured by an organization for use by users, remote support, services, or for administration of resources within a cloud service provider or SaaS application."@en ;
	action:techniqueID "T1087.004" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Office Suite" ;
