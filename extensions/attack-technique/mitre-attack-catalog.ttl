attack:T1078.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1078 ;
	rdfs:label "Valid Accounts: Cloud Accounts"@en ;
	rdfs:comment "Valid accounts in cloud environments may allow adversaries to perform actions to achieve Initial Access, Persistence, Privilege Escalation, or Defense Evasion. Cloud accounts are those created and configured by an organization for use by users, remote support, services, or for administration of resources within a cloud service provider or SaaS application."@en ;
	action:techniqueID "T1078.004" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0004 ;
