	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1486> ;
	.

attack:T1487
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Disk Structure Wipe"@en ;
	rdfs:comment "Adversaries may corrupt or wipe the disk data structures on hard drive necessary to boot systems; targeting specific critical systems as well as a large number of systems in a network to interrupt availability to system and network resources. Revoked by MITRE ATT&CK; superseded by T1561.002."@en ;
	action:techniqueID "T1487" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
