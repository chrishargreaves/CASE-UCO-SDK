	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1078/004> ;
	.

attack:T1079
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Multilayer Encryption"@en ;
	rdfs:comment "An adversary performs C2 communications using multiple layers of encryption, typically (but not exclusively) tunneling a custom encryption scheme within a protocol encryption scheme such as HTTPS or SMTPS. Revoked by MITRE ATT&CK; superseded by T1573."@en ;
	action:techniqueID "T1079" ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1573 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1079> ;
	owl:deprecated true ;
	.

attack:T1080
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Taint Shared Content"@en ;
	rdfs:comment "Adversaries may deliver payloads to remote systems by adding content to shared storage locations, such as network drives or internal code repositories. Content stored on network drives or in other shared locations may be tainted by adding malicious programs, scripts, or exploit code to otherwise valid files. Once a user opens the shared tainted content, the malicious portion can be executed to run the adversary's code on a remote system."@en ;
	action:techniqueID "T1080" ;
	dcterms:subject attack-tactic:TA0008 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1080> ;
	.

attack:T1081
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Credentials in Files"@en ;
	rdfs:comment "Adversaries may search local file systems and remote file shares for files containing passwords. These can be files created by users to store their own credentials, shared credential stores for a group of individuals, configuration files containing passwords for a system or service, or source code/binary files containing embedded passwords. Revoked by MITRE ATT&CK; superseded by T1552.001."@en ;
	action:techniqueID "T1081" ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1552.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1081> ;
	owl:deprecated true ;
	.

attack:T1082
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Information Discovery"@en ;
	rdfs:comment "An adversary may attempt to get detailed information about the operating system and hardware, including version, patches, hotfixes, service packs, and architecture. Adversaries may use this information to shape follow-on behaviors, including whether or not the adversary fully infects the target and/or attempts specific actions. This behavior is distinct from Local Storage Discovery which is an adversary's discovery of local drive, disks and/or volumes."@en ;
	action:techniqueID "T1082" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1082> ;
	.

attack:T1083
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "File and Directory Discovery"@en ;
	rdfs:comment "Adversaries may enumerate files and directories or may search in specific locations of a host or network share for certain information within a file system. Adversaries may use the information from File and Directory Discovery during automated discovery to shape follow-on behaviors, including whether or not the adversary fully infects the target and/or attempts specific actions."@en ;
	action:techniqueID "T1083" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1083> ;
	.

attack:T1084
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Windows Management Instrumentation Event Subscription"@en ;
	rdfs:comment "Windows Management Instrumentation (WMI) can be used to install event filters, providers, consumers, and bindings that execute code when a defined event occurs. Adversaries may use the capabilities of WMI to subscribe to an event and execute arbitrary code when that event occurs, providing persistence on a system. Adversaries may attempt to evade detection of this technique by compiling WMI scripts into Windows Management Object (MOF) files (.mof extension). Revoked by MITRE ATT&CK; superseded by T1546.003."@en ;
	action:techniqueID "T1084" ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1546.003 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1084> ;
	owl:deprecated true ;
	.

attack:T1085
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Rundll32"@en ;
	rdfs:comment "The rundll32.exe program can be called to execute an arbitrary binary. Adversaries may take advantage of this functionality to proxy execution of code to avoid triggering security tools that may not monitor execution of the rundll32.exe process because of whitelists or false positives from Windows using rundll32.exe for normal operations. Revoked by MITRE ATT&CK; superseded by T1218.011."@en ;
	action:techniqueID "T1085" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1218.011 ;
	dcterms:modified "2026-04-14"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1085> ;
	owl:deprecated true ;
	.

attack:T1086
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "PowerShell"@en ;
	rdfs:comment "PowerShell is a powerful interactive command-line interface and scripting environment included in the Windows operating system. Adversaries can use PowerShell to perform a number of actions, including discovery of information and execution of code. Examples include the Start-Process cmdlet which can be used to run an executable and the Invoke-Command cmdlet which runs a command locally or on a remote computer. Revoked by MITRE ATT&CK; superseded by T1059.001."@en ;
	action:techniqueID "T1086" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1059.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
