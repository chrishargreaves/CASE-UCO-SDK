	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1074/001> ;
	.

attack:T1074.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1074 ;
	rdfs:label "Data Staged: Remote Data Staging"@en ;
	rdfs:comment "Adversaries may stage data collected from multiple systems in a central location or directory on one system prior to Exfiltration. Data may be kept in separate files or combined into one file through techniques such as Archive Collected Data. Interactive command shells may be used, and common functionality within cmd and bash may be used to copy data into a staging location."@en ;
	action:techniqueID "T1074.002" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
