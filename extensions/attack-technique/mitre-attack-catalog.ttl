attack:T1496.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1496 ;
	rdfs:label "Resource Hijacking: Bandwidth Hijacking"@en ;
	rdfs:comment "Adversaries may leverage the network bandwidth resources of co-opted systems to complete resource-intensive tasks, which may impact system and/or hosted service availability."@en ;
