attack:T1491
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Defacement"@en ;
	rdfs:comment "Adversaries may modify visual content available internally or externally to an enterprise network, thus affecting the integrity of the original content. Reasons for Defacement include delivering messaging, intimidation, or claiming (possibly false) credit for an intrusion. Disturbing or offensive images may be used as a part of Defacement in order to cause user discomfort, or to pressure compliance with accompanying messages."@en ;
	action:techniqueID "T1491" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1491> ;
	.

attack:T1491.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1491 ;
	rdfs:label "Defacement: Internal Defacement"@en ;
	rdfs:comment "An adversary may deface systems internal to an organization in an attempt to intimidate or mislead users, thus discrediting the integrity of the systems. This may take the form of modifications to internal websites or server login messages, or directly to user systems with the replacement of the desktop wallpaper. Disturbing or offensive images may be used as a part of Internal Defacement in order to cause user discomfort, or to pressure compliance with accompanying messages."@en ;
	action:techniqueID "T1491.001" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1491/001> ;
	.

attack:T1491.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1491 ;
	rdfs:label "Defacement: External Defacement"@en ;
	rdfs:comment "An adversary may deface systems external to an organization in an attempt to deliver messaging, intimidate, or otherwise mislead an organization or users. External Defacement may ultimately cause users to distrust the systems and to question/discredit the system’s integrity. Externally-facing websites are a common victim of defacement; often targeted by adversary and hacktivist groups in order to push a political message or spread propaganda."@en ;
	action:techniqueID "T1491.002" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1491/002> ;
	.

attack:T1492
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Stored Data Manipulation"@en ;
	rdfs:comment "Adversaries may insert, delete, or manipulate data at rest in order to manipulate external outcomes or hide activity. By manipulating stored data, adversaries may attempt to affect a business process, organizational understanding, and decision making. Revoked by MITRE ATT&CK; superseded by T1565.001."@en ;
	action:techniqueID "T1492" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
