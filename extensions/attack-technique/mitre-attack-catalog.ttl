attack:T1496.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1496 ;
	rdfs:label "Resource Hijacking: SMS Pumping"@en ;
	rdfs:comment "Adversaries may leverage messaging services for SMS pumping, which may impact system and/or hosted service availability. SMS pumping is a type of telecommunications fraud whereby a threat actor first obtains a set of phone numbers from a telecommunications provider, then leverages a victim’s messaging infrastructure to send large amounts of SMS messages to numbers in that set."@en ;
	action:techniqueID "T1496.003" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "SaaS" ;
