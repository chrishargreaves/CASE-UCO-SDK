attack:T1191
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "CMSTP"@en ;
	rdfs:comment "The Microsoft Connection Manager Profile Installer (CMSTP.exe) is a command-line program used to install Connection Manager service profiles. CMSTP.exe accepts an installation information file (INF) as a parameter and installs a service profile leveraged for remote access connections. Revoked by MITRE ATT&CK; superseded by T1218.003."@en ;
	action:techniqueID "T1191" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1218.003 ;
	dcterms:modified "2026-04-14"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1191> ;
	owl:deprecated true ;
	.

attack:T1192
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Spearphishing Link"@en ;
	rdfs:comment "Spearphishing with a link is a specific variant of spearphishing. It is different from other forms of spearphishing in that it employs the use of links to download malware contained in email, instead of attaching malicious files to the email itself, to avoid defenses that may inspect email attachments. Revoked by MITRE ATT&CK; superseded by T1566.002."@en ;
	action:techniqueID "T1192" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Office 365" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1566.002 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1192> ;
	owl:deprecated true ;
	.

attack:T1193
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Spearphishing Attachment"@en ;
	rdfs:comment "Spearphishing attachment is a specific variant of spearphishing. Spearphishing attachment is different from other forms of spearphishing in that it employs the use of malware attached to an email. All forms of spearphishing are electronically delivered social engineering targeted at a specific individual, company, or industry. In this scenario, adversaries attach a file to the spearphishing email and usually rely upon User Execution to gain execution. Revoked by MITRE ATT&CK; superseded by T1566.001."@en ;
	action:techniqueID "T1193" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1566.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1193> ;
	owl:deprecated true ;
	.

attack:T1194
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Spearphishing via Service"@en ;
	rdfs:comment "Spearphishing via service is a specific variant of spearphishing. It is different from other forms of spearphishing in that it employs the use of third party services rather than directly via enterprise email channels. Revoked by MITRE ATT&CK; superseded by T1566.003."@en ;
	action:techniqueID "T1194" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1566.003 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1194> ;
	owl:deprecated true ;
	.

attack:T1195
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Supply Chain Compromise"@en ;
	rdfs:comment "Adversaries may manipulate products or product delivery mechanisms prior to receipt by a final consumer for the purpose of data or system compromise."@en ;
	action:techniqueID "T1195" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1195> ;
	.

attack:T1195.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1195 ;
	rdfs:label "Supply Chain Compromise: Compromise Software Dependencies and Development Tools"@en ;
	rdfs:comment "Adversaries may manipulate software dependencies and development tools prior to receipt by a final consumer for the purpose of data or system compromise. Applications often depend on external software to function properly. Popular open source projects that are used as dependencies in many applications, such as pip and NPM packages, may be targeted as a means to add malicious code to users of the dependency."@en ;
	action:techniqueID "T1195.001" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1195/001> ;
	.

attack:T1195.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1195 ;
	rdfs:label "Supply Chain Compromise: Compromise Software Supply Chain"@en ;
	rdfs:comment "Adversaries may manipulate application software prior to receipt by a final consumer for the purpose of data or system compromise. Supply chain compromise of software can take place in a number of ways, including manipulation of the application source code, manipulation of the update/distribution mechanism for that software, or replacing compiled releases with a modified version."@en ;
	action:techniqueID "T1195.002" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1195/002> ;
	.

attack:T1195.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1195 ;
	rdfs:label "Supply Chain Compromise: Compromise Hardware Supply Chain"@en ;
	rdfs:comment "Adversaries may manipulate hardware components in products prior to receipt by a final consumer for the purpose of data or system compromise. By modifying hardware or firmware in the supply chain, adversaries can insert a backdoor into consumer networks that may be difficult to detect and give the adversary a high degree of control over the system. Hardware backdoors may be inserted into various devices, such as servers, workstations, network infrastructure, or peripherals."@en ;
	action:techniqueID "T1195.003" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1195/003> ;
	.

attack:T1196
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Control Panel Items"@en ;
	rdfs:comment "Windows Control Panel items are utilities that allow users to view and adjust computer settings. Control Panel items are registered executable (.exe) or Control Panel (.cpl) files, the latter are actually renamed dynamic-link library (.dll) files that export a CPlApplet function. Control Panel items can be executed directly from the command line, programmatically via an application programming interface (API) call, or by simply double-clicking the file. Revoked by MITRE ATT&CK; superseded by T1218.002."@en ;
	action:techniqueID "T1196" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1218.002 ;
	dcterms:modified "2026-04-14"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1196> ;
	owl:deprecated true ;
	.

attack:T1197
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "BITS Jobs"@en ;
	rdfs:comment "Adversaries may abuse BITS jobs to persistently execute code and perform various background tasks. Windows Background Intelligent Transfer Service (BITS) is a low-bandwidth, asynchronous file transfer mechanism exposed through Component Object Model (COM). BITS is commonly used by updaters, messengers, and other applications preferred to operate in the background (using available idle bandwidth) without interrupting other networked applications."@en ;
	action:techniqueID "T1197" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1197> ;
	.

attack:T1198
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "SIP and Trust Provider Hijacking"@en ;
	rdfs:comment "In user mode, Windows Authenticode digital signatures are used to verify a file's origin and integrity, variables that may be used to establish trust in signed code (ex: a driver with a valid Microsoft signature may be handled as safe). The signature validation process is handled via the WinVerifyTrust application programming interface (API) function, which accepts an inquiry and coordinates with the appropriate trust provider, which is responsible for validating parameters of a signature. Revoked by MITRE ATT&CK; superseded by T1553.003."@en ;
	action:techniqueID "T1198" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1553.003 ;
	dcterms:modified "2026-04-14"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1198> ;
	owl:deprecated true ;
	.

attack:T1199
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Trusted Relationship"@en ;
	rdfs:comment "Adversaries may breach or otherwise leverage organizations who have access to intended victims. Access through trusted third party relationship abuses an existing connection that may not be protected or receives less scrutiny than standard mechanisms of gaining access to a network."@en ;
	action:techniqueID "T1199" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1199> ;
	.

attack:T1200
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Hardware Additions"@en ;
	rdfs:comment "Adversaries may physically introduce computer accessories, networking hardware, or other computing devices into a system or network that can be used as a vector to gain access. Rather than just connecting and distributing payloads via removable storage (i.e. Replication Through Removable Media), more robust hardware additions can be used to introduce new functionalities and/or features into a system that can then be abused."@en ;
	action:techniqueID "T1200" ;
	dcterms:subject attack-tactic:TA0001 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1200> ;
	.

attack:T1201
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Password Policy Discovery"@en ;
	rdfs:comment "Adversaries may attempt to access detailed information about the password policy used within an enterprise network or cloud environment. Password policies are a way to enforce complex passwords that are difficult to guess or crack through Brute Force. This information may help the adversary to create a list of common passwords and launch dictionary and/or brute force attacks which adheres to the policy (e.g."@en ;
	action:techniqueID "T1201" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1201> ;
	.

attack:T1202
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Indirect Command Execution"@en ;
	rdfs:comment "Adversaries may abuse utilities that allow for command execution to bypass security restrictions that limit the use of command-line interpreters. Various Windows utilities may be used to execute commands, possibly without invoking cmd."@en ;
	action:techniqueID "T1202" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1202> ;
	.

attack:T1203
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Client Execution"@en ;
	rdfs:comment "Adversaries may exploit software vulnerabilities in client applications to execute code. Vulnerabilities can exist in software due to unsecure coding practices that can lead to unanticipated behavior. Adversaries can take advantage of certain vulnerabilities through targeted exploitation for the purpose of arbitrary code execution."@en ;
	action:techniqueID "T1203" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1203> ;
	.

attack:T1204
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "User Execution"@en ;
	rdfs:comment "An adversary may rely upon specific actions by a user in order to gain execution. Users may be subjected to social engineering to get them to execute malicious code by, for example, opening a malicious document file or link. These user actions will typically be observed as follow-on behavior from forms of Phishing."@en ;
	action:techniqueID "T1204" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Containers" ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204> ;
	.

attack:T1204.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1204 ;
	rdfs:label "User Execution: Malicious Link"@en ;
	rdfs:comment "An adversary may rely upon a user clicking a malicious link in order to gain execution. Users may be subjected to social engineering to get them to click on a link that will lead to code execution. This user action will typically be observed as follow-on behavior from Spearphishing Link. Clicking on a link may also lead to other execution techniques such as exploitation of a browser or application vulnerability via Exploitation for Client Execution."@en ;
	action:techniqueID "T1204.001" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204/001> ;
	.

attack:T1204.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1204 ;
	rdfs:label "User Execution: Malicious File"@en ;
	rdfs:comment "An adversary may rely upon a user opening a malicious file in order to gain execution. Users may be subjected to social engineering to get them to open a file that will lead to code execution. This user action will typically be observed as follow-on behavior from Spearphishing Attachment. Adversaries may use several types of files that require a user to execute them, including .doc, .pdf, .xls, .rtf, .scr, .exe, .lnk, .pif, .cpl, .reg, and .iso."@en ;
	action:techniqueID "T1204.002" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204/002> ;
	.

attack:T1204.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1204 ;
	rdfs:label "User Execution: Malicious Image"@en ;
	rdfs:comment "Adversaries may rely on a user running a malicious image to facilitate execution. Amazon Web Services (AWS) Amazon Machine Images (AMIs), Google Cloud Platform (GCP) Images, and Azure Images as well as popular container runtimes such as Docker can be backdoored."@en ;
	action:techniqueID "T1204.003" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Containers" ;
	dcterms:coverage "IaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204/003> ;
	.

attack:T1204.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1204 ;
	rdfs:label "User Execution: Malicious Copy and Paste"@en ;
	rdfs:comment "An adversary may rely upon a user copying and pasting code in order to gain execution. Users may be subjected to social engineering to get them to copy and paste code directly into a Command and Scripting Interpreter. One such strategy is \"ClickFix,\" in which adversaries present users with seemingly helpful solutions—such as prompts to fix errors or complete CAPTCHAs—that instead instruct the user to copy and paste malicious code."@en ;
	action:techniqueID "T1204.004" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204/004> ;
	.

attack:T1204.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1204 ;
	rdfs:label "User Execution: Malicious Library"@en ;
	rdfs:comment "Adversaries may rely on a user installing a malicious library to facilitate execution. Threat actors may Upload Malware to package managers such as NPM and PyPi, as well as to public code repositories such as GitHub. User may install libraries without realizing they are malicious, thus bypassing techniques that specifically achieve Initial Access. This can lead to the execution of malicious code, such as code that establishes persistence, steals data, or mines cryptocurrency."@en ;
	action:techniqueID "T1204.005" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-05-22"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1204/005> ;
	.

attack:T1205
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Traffic Signaling"@en ;
	rdfs:comment "Adversaries may use traffic signaling to hide open ports or other malicious functionality used for persistence or command and control. Traffic signaling involves the use of a magic value or sequence that must be sent to a system to trigger a special response, such as opening a closed port or executing a malicious task. This may take the form of sending a series of packets with certain characteristics before a port will be opened that the adversary can use for command and control."@en ;
	action:techniqueID "T1205" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1205> ;
	.

attack:T1205.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1205 ;
	rdfs:label "Traffic Signaling: Port Knocking"@en ;
	rdfs:comment "Adversaries may use port knocking to hide open ports used for persistence or command and control. To enable a port, an adversary sends a series of attempted connections to a predefined sequence of closed ports. After the sequence is completed, opening a port is often accomplished by the host based firewall, but could also be implemented by custom software."@en ;
	action:techniqueID "T1205.001" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1205/001> ;
	.

attack:T1205.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1205 ;
	rdfs:label "Traffic Signaling: Socket Filters"@en ;
	rdfs:comment "Adversaries may attach filters to a network socket to monitor then activate backdoors used for persistence or command and control. With elevated permissions, adversaries can use features such as the `libpcap` library to open sockets and install filters to allow or disallow certain types of data to come through the socket. The filter may apply to all traffic passing through the specified network interface (or every interface if not specified)."@en ;
	action:techniqueID "T1205.002" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1205/002> ;
	.

attack:T1206
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Sudo Caching"@en ;
	rdfs:comment "The sudo command \"allows a system administrator to delegate authority to give certain users (or groups of users) the ability to run some (or all) commands as root or another user while providing an audit trail of the commands and their arguments.\" Since sudo was made for the system administrator, it has some useful configuration features such as a timestamp_timeout that is the amount of time in minutes between instances of sudo before it will re-prompt for a password. Revoked by MITRE ATT&CK; superseded by T1548.003."@en ;
	action:techniqueID "T1206" ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1548.003 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1206> ;
	owl:deprecated true ;
	.

attack:T1207
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Rogue Domain Controller"@en ;
	rdfs:comment "Adversaries may register a rogue Domain Controller to enable manipulation of Active Directory data. DCShadow may be used to create a rogue Domain Controller (DC). DCShadow is a method of manipulating Active Directory (AD) data, including objects and schemas, by registering (or reusing an inactive registration) and simulating the behavior of a DC. Once registered, a rogue DC may be able to inject and replicate changes into AD infrastructure for any domain object, including credentials and keys."@en ;
	action:techniqueID "T1207" ;
	dcterms:subject attack-tactic:TA0112 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1207> ;
	.

attack:T1208
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Kerberoasting"@en ;
	rdfs:comment "Service principal names (SPNs) are used to uniquely identify each instance of a Windows service. To enable authentication, Kerberos requires that SPNs be associated with at least one service logon account (an account specifically tasked with running a service). Revoked by MITRE ATT&CK; superseded by T1558.003."@en ;
	action:techniqueID "T1208" ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1558.003 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1208> ;
	owl:deprecated true ;
	.

attack:T1209
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Time Providers"@en ;
	rdfs:comment "The Windows Time service (W32Time) enables time synchronization across and within domains. W32Time time providers are responsible for retrieving time stamps from hardware/network resources and outputting these values to other network clients. Revoked by MITRE ATT&CK; superseded by T1547.003."@en ;
	action:techniqueID "T1209" ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1547.003 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1209> ;
	owl:deprecated true ;
	.

attack:T1210
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation of Remote Services"@en ;
	rdfs:comment "Adversaries may exploit remote services to gain unauthorized access to internal systems once inside of a network. Exploitation of a software vulnerability occurs when an adversary takes advantage of a programming error in a program, service, or within the operating system software or kernel itself to execute adversary-controlled code. A common goal for post-compromise exploitation of remote services is for lateral movement to enable access to a remote system."@en ;
	action:techniqueID "T1210" ;
	dcterms:subject attack-tactic:TA0008 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-08-04"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1210> ;
	.

attack:T1211
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Stealth"@en ;
	rdfs:comment "Adversaries may exploit vulnerabilities to evade detection by hiding activity, suppressing logging, or operating within trusted or unmonitored components."@en ;
	action:techniqueID "T1211" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1211> ;
	.

attack:T1212
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Credential Access"@en ;
	rdfs:comment "Adversaries may exploit software vulnerabilities in an attempt to collect credentials. Exploitation of a software vulnerability occurs when an adversary takes advantage of a programming error in a program, service, or within the operating system software or kernel itself to execute adversary-controlled code."@en ;
	action:techniqueID "T1212" ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1212> ;
	.

attack:T1213
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Data from Information Repositories"@en ;
	rdfs:comment "Adversaries may leverage information repositories to mine valuable information. Information repositories are tools that allow for storage of information, typically to facilitate collaboration or information sharing between users, and can store a wide variety of data that may aid adversaries in further objectives, such as Credential Access, Lateral Movement, or Defense Evasion, or direct access to the target information."@en ;
	action:techniqueID "T1213" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213> ;
	.

attack:T1213.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Confluence"@en ;
	rdfs:comment "Adversaries may leverage Confluence repositories to mine valuable information. Often found in development environments alongside Atlassian JIRA, Confluence is generally used to store development-related documentation, however, in general may contain more diverse categories of useful information, such as:"@en ;
	action:techniqueID "T1213.001" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "SaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/001> ;
	.

attack:T1213.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Sharepoint"@en ;
	rdfs:comment "Adversaries may leverage the SharePoint repository as a source to mine valuable information. SharePoint will often contain useful information for an adversary to learn about the structure and functionality of the internal network and systems. For example, the following is a list of example information that may hold potential value to an adversary and may also be found on SharePoint:"@en ;
	action:techniqueID "T1213.002" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/002> ;
	.

attack:T1213.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Code Repositories"@en ;
	rdfs:comment "Adversaries may leverage code repositories to collect valuable information. Code repositories are tools/services that store source code and automate software builds. They may be hosted internally or privately on third party sites such as Github, GitLab, SourceForge, and BitBucket. Users typically interact with code repositories through a web application or command-line utilities such as git."@en ;
	action:techniqueID "T1213.003" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "SaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/003> ;
	.

attack:T1213.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Customer Relationship Management Software"@en ;
	rdfs:comment "Adversaries may leverage Customer Relationship Management (CRM) software to mine valuable information. CRM software is used to assist organizations in tracking and managing customer interactions, as well as storing customer data."@en ;
	action:techniqueID "T1213.004" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "SaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-04-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/004> ;
	.

attack:T1213.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Messaging Applications"@en ;
	rdfs:comment "Adversaries may leverage chat and messaging applications, such as Microsoft Teams, Google Chat, and Slack, to mine valuable information."@en ;
	action:techniqueID "T1213.005" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/005> ;
	.

attack:T1213.006
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1213 ;
	rdfs:label "Data from Information Repositories: Databases"@en ;
	rdfs:comment "Adversaries may leverage databases to mine valuable information. These databases may be hosted on-premises or in the cloud (both in platform-as-a-service and software-as-a-service environments)."@en ;
	action:techniqueID "T1213.006" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1213/006> ;
	.

attack:T1214
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Credentials in Registry"@en ;
	rdfs:comment "The Windows Registry stores configuration information that can be used by the system or other programs. Adversaries may query the Registry looking for credentials and passwords that have been stored for use by other programs or services. Sometimes these credentials are used for automatic logons. Revoked by MITRE ATT&CK; superseded by T1552.002."@en ;
	action:techniqueID "T1214" ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1552.002 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1214> ;
	owl:deprecated true ;
	.

attack:T1215
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Kernel Modules and Extensions"@en ;
	rdfs:comment "Loadable Kernel Modules (or LKMs) are pieces of code that can be loaded and unloaded into the kernel upon demand. They extend the functionality of the kernel without the need to reboot the system. For example, one type of module is the device driver, which allows the kernel to access hardware connected to the system. When used maliciously, Loadable Kernel Modules (LKMs) can be a type of kernel-mode Rootkit that run with the highest operating system privilege (Ring 0). Revoked by MITRE ATT&CK; superseded by T1547.006."@en ;
	action:techniqueID "T1215" ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1547.006 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1215> ;
	owl:deprecated true ;
	.

attack:T1216
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Script Proxy Execution"@en ;
	rdfs:comment "Adversaries may use trusted scripts, often signed with certificates, to proxy the execution of malicious files. Several Microsoft signed scripts that have been downloaded from Microsoft or are default on Windows installations can be used to proxy execution of other files. This behavior may be abused by adversaries to execute malicious files that could bypass application control and signature validation on systems."@en ;
	action:techniqueID "T1216" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1216> ;
	.

attack:T1216.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1216 ;
	rdfs:label "System Script Proxy Execution: PubPrn"@en ;
	rdfs:comment "Adversaries may use PubPrn to proxy execution of malicious remote files. PubPrn.vbs is a Visual Basic script that publishes a printer to Active Directory Domain Services. The script may be signed by Microsoft and is commonly executed through the Windows Command Shell via Cscript.exe. For example, the following code publishes a printer within the specified domain: cscript pubprn Printer1 LDAP://CN=Container1,DC=Domain1,DC=Com."@en ;
	action:techniqueID "T1216.001" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1216/001> ;
	.

attack:T1216.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1216 ;
	rdfs:label "System Script Proxy Execution: SyncAppvPublishingServer"@en ;
	rdfs:comment "Adversaries may abuse SyncAppvPublishingServer.vbs to proxy execution of malicious PowerShell commands. SyncAppvPublishingServer.vbs is a Visual Basic script associated with how Windows virtualizes applications (Microsoft Application Virtualization, or App-V). For example, Windows may render Win32 applications to users as virtual applications, allowing users to launch and interact with them as if they were installed locally."@en ;
	action:techniqueID "T1216.002" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1216/002> ;
	.

attack:T1217
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Browser Information Discovery"@en ;
	rdfs:comment "Adversaries may enumerate information about browsers to learn more about compromised environments. Data saved by browsers (such as bookmarks, accounts, and browsing history) may reveal a variety of personal information about users (e.g., banking sites, relationships/interests, social media, etc.) as well as details about internal network resources such as servers, tools/dashboards, or other related infrastructure."@en ;
	action:techniqueID "T1217" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1217> ;
	.

attack:T1218
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Binary Proxy Execution"@en ;
	rdfs:comment "Adversaries may bypass process and/or signature-based defenses by proxying execution of malicious content with signed, or otherwise trusted, binaries. Binaries used in this technique are often Microsoft-signed files, indicating that they have been either downloaded from Microsoft or are already native in the operating system. Binaries signed with trusted digital certificates can typically execute on Windows systems protected by digital signature validation."@en ;
	action:techniqueID "T1218" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218> ;
	.

attack:T1218.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Compiled HTML File"@en ;
	rdfs:comment "Adversaries may abuse Compiled HTML files (.chm) to conceal malicious code. CHM files are commonly distributed as part of the Microsoft HTML Help system. CHM files are compressed compilations of various content such as HTML documents, images, and scripting/web related programming languages such VBA, JScript, Java, and ActiveX. CHM content is displayed using underlying components of the Internet Explorer browser loaded by the HTML Help executable program (hh.exe)."@en ;
	action:techniqueID "T1218.001" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/001> ;
	.

attack:T1218.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Control Panel"@en ;
	rdfs:comment "Adversaries may abuse control.exe to proxy execution of malicious payloads. The Windows Control Panel process binary (control.exe) handles execution of Control Panel items, which are utilities that allow users to view and adjust computer settings."@en ;
	action:techniqueID "T1218.002" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/002> ;
	.

attack:T1218.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: CMSTP"@en ;
	rdfs:comment "Adversaries may abuse CMSTP to proxy execution of malicious code. The Microsoft Connection Manager Profile Installer (CMSTP.exe) is a command-line program used to install Connection Manager service profiles. CMSTP.exe accepts an installation information file (INF) as a parameter and installs a service profile leveraged for remote access connections."@en ;
	action:techniqueID "T1218.003" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/003> ;
	.

attack:T1218.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: InstallUtil"@en ;
	rdfs:comment "Adversaries may use InstallUtil to proxy execution of code through a trusted Windows utility. InstallUtil is a command-line utility that allows for installation and uninstallation of resources by executing specific installer components specified in .NET binaries. The InstallUtil binary may also be digitally signed by Microsoft and located in the .NET directories on a Windows system: C:\\Windows\\Microsoft.NET\\Framework\\v\\InstallUtil.exe and C:\\Windows\\Microsoft.NET\\Framework64\\v\\InstallUtil.exe."@en ;
	action:techniqueID "T1218.004" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/004> ;
	.

attack:T1218.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Mshta"@en ;
	rdfs:comment "Adversaries may abuse mshta.exe to proxy execution of malicious .hta files and Javascript or VBScript through a trusted Windows utility. There are several examples of different types of threats leveraging mshta.exe during initial compromise and for execution of code"@en ;
	action:techniqueID "T1218.005" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/005> ;
	.

attack:T1218.007
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Msiexec"@en ;
	rdfs:comment "Adversaries may abuse msiexec.exe to proxy execution of malicious payloads. Msiexec.exe is the command-line utility for the Windows Installer and is thus commonly associated with executing installation packages (.msi). The Msiexec.exe binary may also be digitally signed by Microsoft."@en ;
	action:techniqueID "T1218.007" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/007> ;
	.

attack:T1218.008
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Odbcconf"@en ;
	rdfs:comment "Adversaries may abuse odbcconf.exe to proxy execution of malicious payloads. Odbcconf.exe is a Windows utility that allows you to configure Open Database Connectivity (ODBC) drivers and data source names. The Odbcconf.exe binary may be digitally signed by Microsoft."@en ;
	action:techniqueID "T1218.008" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/008> ;
	.

attack:T1218.009
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Regsvcs/Regasm"@en ;
	rdfs:comment "Adversaries may abuse Regsvcs and Regasm to proxy execution of code through a trusted Windows utility. Regsvcs and Regasm are Windows command-line utilities that are used to register .NET Component Object Model (COM) assemblies. Both are binaries that may be digitally signed by Microsoft."@en ;
	action:techniqueID "T1218.009" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/009> ;
	.

attack:T1218.010
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Regsvr32"@en ;
	rdfs:comment "Adversaries may abuse Regsvr32.exe to proxy execution of malicious code. Regsvr32.exe is a command-line program used to register and unregister object linking and embedding controls, including dynamic link libraries (DLLs), on Windows systems. The Regsvr32.exe binary may also be signed by Microsoft."@en ;
	action:techniqueID "T1218.010" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/010> ;
	.

attack:T1218.011
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Rundll32"@en ;
	rdfs:comment "Adversaries may abuse rundll32.exe to proxy execution of malicious code. Using rundll32.exe, vice executing directly (i.e. Shared Modules), may avoid triggering security tools that may not monitor execution of the rundll32.exe process because of allowlists or false positives from normal operations. Rundll32.exe is commonly associated with executing DLL payloads (ex: rundll32.exe {DLLname, DLLfunction})."@en ;
	action:techniqueID "T1218.011" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/011> ;
	.

attack:T1218.012
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Verclsid"@en ;
	rdfs:comment "Adversaries may abuse verclsid.exe to proxy execution of malicious code. Verclsid.exe is known as the Extension CLSID Verification Host and is responsible for verifying each shell extension before they are used by Windows Explorer or the Windows Shell."@en ;
	action:techniqueID "T1218.012" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/012> ;
	.

attack:T1218.013
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Mavinject"@en ;
	rdfs:comment "Adversaries may abuse mavinject.exe to proxy execution of malicious code. Mavinject.exe is the Microsoft Application Virtualization Injector, a Windows utility that can inject code into external processes as part of Microsoft Application Virtualization (App-V)."@en ;
	action:techniqueID "T1218.013" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/013> ;
	.

attack:T1218.014
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: MMC"@en ;
	rdfs:comment "Adversaries may abuse mmc.exe to proxy execution of malicious .msc files. Microsoft Management Console (MMC) is a binary that may be signed by Microsoft and is used in several ways in either its GUI or in a command prompt. MMC can be used to create, open, and save custom consoles that contain administrative tools created by Microsoft, called snap-ins. These snap-ins may be used to manage Windows systems locally or remotely."@en ;
	action:techniqueID "T1218.014" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/014> ;
	.

attack:T1218.015
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1218 ;
	rdfs:label "System Binary Proxy Execution: Electron Applications"@en ;
	rdfs:comment "Adversaries may abuse components of the Electron framework to execute malicious code. The Electron framework hosts many common applications such as Signal, Slack, and Microsoft Teams. Originally developed by GitHub, Electron is a cross-platform desktop application development framework that employs web technologies like JavaScript, HTML, and CSS. The Chromium engine is used to display web content and Node.js runs the backend code."@en ;
	action:techniqueID "T1218.015" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1218/015> ;
	.

attack:T1219
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Remote Access Tools"@en ;
	rdfs:comment "An adversary may use legitimate remote access tools to establish an interactive command and control channel within a network. Remote access tools create a session between two trusted hosts through a graphical interface, a command line interaction, a protocol tunnel via development or management software, or hardware-level access such as KVM (Keyboard, Video, Mouse) over IP solutions."@en ;
	action:techniqueID "T1219" ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1219> ;
	.

attack:T1219.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1219 ;
	rdfs:label "Remote Access Tools: IDE Tunneling"@en ;
	rdfs:comment "Adversaries may abuse Integrated Development Environment (IDE) software with remote development features to establish an interactive command and control channel on target systems within a network. IDE tunneling combines SSH, port forwarding, file sharing, and debugging into a single secure connection, letting developers work on remote systems as if they were local."@en ;
	action:techniqueID "T1219.001" ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1219/001> ;
	.

attack:T1219.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1219 ;
	rdfs:label "Remote Access Tools: Remote Desktop Software"@en ;
	rdfs:comment "An adversary may use legitimate desktop support software to establish an interactive command and control channel to target systems within networks. Desktop support software provides a graphical interface for remotely controlling another computer, transmitting the display output, keyboard input, and mouse control between devices using various protocols."@en ;
	action:techniqueID "T1219.002" ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1219/002> ;
	.

attack:T1219.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1219 ;
	rdfs:label "Remote Access Tools: Remote Access Hardware"@en ;
	rdfs:comment "An adversary may use legitimate remote access hardware to establish an interactive command and control channel to target systems within networks. These services, including IP-based keyboard, video, or mouse (KVM) devices such as TinyPilot and PiKVM, are commonly used as legitimate tools and may be allowed by peripheral device policies within a target environment."@en ;
	action:techniqueID "T1219.003" ;
	dcterms:subject attack-tactic:TA0011 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-05-02"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1219/003> ;
	.

attack:T1220
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "XSL Script Processing"@en ;
	rdfs:comment "Adversaries may bypass application control and obscure execution of code by embedding scripts inside XSL files. Extensible Stylesheet Language (XSL) files are commonly used to describe the processing and rendering of data within XML files. To support complex operations, the XSL standard includes support for embedded scripting in various languages."@en ;
	action:techniqueID "T1220" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1220> ;
	.

attack:T1221
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Template Injection"@en ;
	rdfs:comment "Adversaries may create or modify references in user document templates to conceal malicious code or force authentication attempts. For example, Microsoft’s Office Open XML (OOXML) specification defines an XML-based format for Office documents (.docx, xlsx, .pptx) to replace older binary formats (.doc, .xls, .ppt). OOXML files are packed together ZIP archives compromised of various XML files, referred to as parts, containing properties that collectively define how a document is rendered."@en ;
	action:techniqueID "T1221" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1221> ;
	.

attack:T1222
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "File and Directory Permissions Modification"@en ;
	rdfs:comment "Adversaries may modify file or directory permissions/attributes to evade access control lists (ACLs) and access protected files. File and directory permissions are commonly managed by ACLs configured by the file or directory owner, or users with the appropriate permissions. File and directory ACL implementations vary by platform, but generally explicitly designate which users or groups can perform which actions (read, write, execute, etc.)."@en ;
	action:techniqueID "T1222" ;
	dcterms:subject attack-tactic:TA0112 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1222> ;
	.

attack:T1222.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1222 ;
	rdfs:label "File and Directory Permissions Modification: Windows Permissions"@en ;
	rdfs:comment "Adversaries may modify file or directory permissions/attributes to evade access control lists (ACLs) and access protected files. File and directory permissions are commonly managed by ACLs configured by the file or directory owner, or users with the appropriate permissions. File and directory ACL implementations vary by platform, but generally explicitly designate which users or groups can perform which actions (read, write, execute, etc.)."@en ;
	action:techniqueID "T1222.001" ;
	dcterms:subject attack-tactic:TA0112 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1222/001> ;
	.

attack:T1222.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1222 ;
	rdfs:label "File and Directory Permissions Modification: Linux and Mac Permissions"@en ;
	rdfs:comment "Adversaries may modify file or directory permissions/attributes to evade access control lists (ACLs) and access protected files. File and directory permissions are commonly managed by ACLs configured by the file or directory owner, or users with the appropriate permissions. File and directory ACL implementations vary by platform, but generally explicitly designate which users or groups can perform which actions (read, write, execute, etc.)."@en ;
	action:techniqueID "T1222.002" ;
	dcterms:subject attack-tactic:TA0112 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1222/002> ;
	.

attack:T1223
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Compiled HTML File"@en ;
	rdfs:comment "Compiled HTML files (.chm) are commonly distributed as part of the Microsoft HTML Help system. CHM files are compressed compilations of various content such as HTML documents, images, and scripting/web related programming languages such VBA, JScript, Java, and ActiveX. CHM content is displayed using underlying components of the Internet Explorer browser loaded by the HTML Help executable program (hh.exe). Revoked by MITRE ATT&CK; superseded by T1218.001."@en ;
	action:techniqueID "T1223" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1218.001 ;
	dcterms:modified "2026-04-14"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1223> ;
	owl:deprecated true ;
	.

attack:T1398
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Boot or Logon Initialization Scripts"@en ;
	rdfs:comment "Adversaries may use scripts automatically executed at boot or logon initialization to establish persistence. Initialization scripts are part of the underlying operating system and are not accessible to the user unless the device has been rooted or jailbroken."@en ;
	action:techniqueID "T1398" ;
	dcterms:subject attack-tactic:TA0028 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1398> ;
	.

attack:T1399
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Modify Trusted Execution Environment"@en ;
	rdfs:comment "If an adversary can escalate privileges, he or she may be able to use those privileges to place malicious code in the device's Trusted Execution Environment (TEE) or other similar isolated execution environment where the code can evade detection, may persist after device resets, and may not be removable by the device user. Running code within the TEE may provide an adversary with the ability to monitor or tamper with overall device behavior. Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1399" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:subject attack-tactic:TA0028 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1399> ;
	owl:deprecated true ;
	.

attack:T1400
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Modify System Partition"@en ;
	rdfs:comment "If an adversary can escalate privileges, he or she may be able to use those privileges to place malicious code in the device system partition, where it may persist after device resets and may not be easily removed by the device user. Revoked by MITRE ATT&CK; superseded by T1625.001."@en ;
	action:techniqueID "T1400" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:subject attack-tactic:TA0028 ;
	dcterms:subject attack-tactic:TA0034 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1625.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1400> ;
	owl:deprecated true ;
	.

attack:T1401
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Device Administrator Permissions"@en ;
	rdfs:comment "Adversaries may request device administrator permissions to perform malicious actions. Revoked by MITRE ATT&CK; superseded by T1626.001."@en ;
	action:techniqueID "T1401" ;
	dcterms:subject attack-tactic:TA0029 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1626.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1401> ;
	owl:deprecated true ;
	.

attack:T1402
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Broadcast Receivers"@en ;
	rdfs:comment "An intent is a message passed between Android application or system components. Applications can register to receive broadcast intents at runtime, which are system-wide intents delivered to each app when certain events happen on the device, such as network changes or the user unlocking the screen. Malicious applications can then trigger certain actions within the app based on which broadcast intent was received. Revoked by MITRE ATT&CK; superseded by T1624.001."@en ;
	action:techniqueID "T1402" ;
	dcterms:subject attack-tactic:TA0028 ;
	dcterms:subject attack-tactic:TA0041 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1624.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1402> ;
	owl:deprecated true ;
	.

attack:T1403
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Modify Cached Executable Code"@en ;
	rdfs:comment "ART (the Android Runtime) compiles optimized code on the device itself to improve performance. An adversary may be able to use escalated privileges to modify the cached code in order to hide malicious behavior. Since the code is compiled on the device, it may not receive the same level of integrity checks that are provided to code running in the system partition. Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1403" ;
	dcterms:subject attack-tactic:TA0028 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1403> ;
	owl:deprecated true ;
	.

attack:T1404
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation for Privilege Escalation"@en ;
	rdfs:comment "Adversaries may exploit software vulnerabilities in order to elevate privileges. Exploitation of a software vulnerability occurs when an adversary takes advantage of a programming error in an application, service, within the operating system software, or kernel itself to execute adversary-controlled code. Security constructions, such as permission levels, will often hinder access to information and use of certain techniques."@en ;
	action:techniqueID "T1404" ;
	dcterms:subject attack-tactic:TA0029 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1404> ;
	.

attack:T1405
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploit TEE Vulnerability"@en ;
	rdfs:comment "A malicious app or other attack vector could be used to exploit vulnerabilities in code running within the Trusted Execution Environment (TEE). The adversary could then obtain privileges held by the TEE potentially including the ability to access cryptographic keys or other sensitive data. Escalated operating system privileges may be first required in order to have the ability to attack the TEE. If not, privileges within the TEE can potentially be used to exploit the operating system. Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1405" ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:subject attack-tactic:TA0029 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-04-18"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1405> ;
	owl:deprecated true ;
	.

attack:T1406
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Obfuscated Files or Information"@en ;
	rdfs:comment "Adversaries may attempt to make a payload or file difficult to discover or analyze by encrypting, encoding, or otherwise obfuscating its contents on the device or in transit. This is common behavior that can be used across different platforms and the network to evade defenses."@en ;
	action:techniqueID "T1406" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1406> ;
	.

attack:T1406.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1406 ;
	rdfs:label "Obfuscated Files or Information: Steganography"@en ;
	rdfs:comment "Adversaries may use steganography techniques in order to prevent the detection of hidden information. Steganographic techniques can be used to hide data in digital media such as images, audio tracks, video clips, or text files."@en ;
	action:techniqueID "T1406.001" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1406/001> ;
	.

attack:T1406.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1406 ;
	rdfs:label "Obfuscated Files or Information: Software Packing"@en ;
	rdfs:comment "Adversaries may perform software packing to conceal their code. Software packing is a method of compressing or encrypting an executable. Packing an executable changes the file signature in an attempt to avoid signature-based detection. Most decompression techniques decompress the executable code in memory."@en ;
	action:techniqueID "T1406.002" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1406/002> ;
	.

attack:T1407
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Download New Code at Runtime"@en ;
	rdfs:comment "Adversaries may download and execute dynamic code not included in the original application package after installation. This technique is primarily used to evade static analysis checks and pre-publication scans in official app stores. In some cases, more advanced dynamic or behavioral analysis techniques could detect this behavior. However, in conjunction with Execution Guardrails techniques, detecting malicious code downloaded after installation could be difficult."@en ;
	action:techniqueID "T1407" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1407> ;
	.

attack:T1408
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Disguise Root/Jailbreak Indicators"@en ;
	rdfs:comment "An adversary could use knowledge of the techniques used by security software to evade detection. For example, some mobile security products perform compromised device detection by searching for particular artifacts such as an installed \"su\" binary, but that check could be evaded by naming the binary something else. Similarly, polymorphic code techniques could be used to evade signature-based detection. Revoked by MITRE ATT&CK; superseded by T1630.003."@en ;
	action:techniqueID "T1408" ;
	dcterms:subject attack-tactic:TA0030 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1630.003 ;
	dcterms:modified "2025-04-18"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1408> ;
	owl:deprecated true ;
	.

attack:T1409
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Stored Application Data"@en ;
	rdfs:comment "Adversaries may try to access and collect application data resident on the device. Adversaries often target popular applications, such as Facebook, WeChat, and Gmail."@en ;
	action:techniqueID "T1409" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1409> ;
	.

attack:T1410
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Network Traffic Capture or Redirection"@en ;
	rdfs:comment "An adversary may capture network traffic to and from the device to obtain credentials or other sensitive data, or redirect network traffic to flow through an adversary-controlled gateway to do the same. Revoked by MITRE ATT&CK; superseded by T1638."@en ;
	action:techniqueID "T1410" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1638 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1410> ;
	owl:deprecated true ;
	.

attack:T1411
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Input Prompt"@en ;
	rdfs:comment "The operating system and installed applications often have legitimate needs to prompt the user for sensitive information such as account credentials, bank account information, or Personally Identifiable Information (PII). Adversaries may mimic this functionality to prompt users for sensitive information. Revoked by MITRE ATT&CK; superseded by T1417.002."@en ;
	action:techniqueID "T1411" ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1417.002 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1411> ;
	owl:deprecated true ;
	.

attack:T1412
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Capture SMS Messages"@en ;
	rdfs:comment "A malicious application could capture sensitive data sent via SMS, including authentication credentials. SMS is frequently used to transmit codes used for multi-factor authentication. Revoked by MITRE ATT&CK; superseded by T1636.004."@en ;
	action:techniqueID "T1412" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1636.004 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1412> ;
	owl:deprecated true ;
	.

attack:T1413
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Access Sensitive Data in Device Logs"@en ;
	rdfs:comment "On versions of Android prior to 4.1, an adversary may use a malicious application that holds the READ_LOGS permission to obtain private keys, passwords, other credentials, or other sensitive data stored in the device's system log. On Android 4.1 and later, an adversary would need to attempt to perform an operating system privilege escalation attack to be able to access the log. Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1413" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-04-18"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1413> ;
	owl:deprecated true ;
	.

attack:T1414
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Clipboard Data"@en ;
	rdfs:comment "Adversaries may abuse clipboard manager APIs to obtain sensitive information copied to the device clipboard. For example, passwords being copied and pasted from a password manager application could be captured by a malicious application installed on the device."@en ;
	action:techniqueID "T1414" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1414> ;
	.

attack:T1415
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "URL Scheme Hijacking"@en ;
	rdfs:comment "An iOS application may be able to maliciously claim a URL scheme, allowing it to intercept calls that are meant for a different application. This technique, for example, could be used to capture OAuth authorization codes or to phish user credentials. Revoked by MITRE ATT&CK; superseded by T1635.001."@en ;
	action:techniqueID "T1415" ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1635.001 ;
	dcterms:modified "2025-09-08"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1415> ;
	owl:deprecated true ;
	.

attack:T1416
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "URI Hijacking"@en ;
	rdfs:comment "Adversaries may register Uniform Resource Identifiers (URIs) to intercept sensitive data. Revoked by MITRE ATT&CK; superseded by T1635.001."@en ;
	action:techniqueID "T1416" ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1635.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1416> ;
	owl:deprecated true ;
	.

attack:T1417
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Input Capture"@en ;
	rdfs:comment "Adversaries may use methods of capturing user input to obtain credentials or collect information. During normal device usage, users often provide credentials to various locations, such as login pages/portals or system dialog boxes. Input capture mechanisms may be transparent to the user (e.g. Keylogging) or rely on deceiving the user into providing input into what they believe to be a genuine application prompt (e.g. GUI Input Capture)."@en ;
	action:techniqueID "T1417" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1417> ;
	.

attack:T1417.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1417 ;
	rdfs:label "Input Capture: Keylogging"@en ;
	rdfs:comment "Adversaries may log user keystrokes to intercept credentials or other information from the user as the user types them."@en ;
	action:techniqueID "T1417.001" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1417/001> ;
	.

attack:T1417.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1417 ;
	rdfs:label "Input Capture: GUI Input Capture"@en ;
	rdfs:comment "Adversaries may mimic common operating system GUI components to prompt users for sensitive information with a seemingly legitimate prompt. The operating system and installed applications often have legitimate needs to prompt the user for sensitive information such as account credentials, bank account information, or Personally Identifiable Information (PII)."@en ;
	action:techniqueID "T1417.002" ;
	dcterms:subject attack-tactic:TA0031 ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1417/002> ;
	.

attack:T1418
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Software Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of applications that are installed on a device. Adversaries may use the information from Software Discovery during automated discovery to shape follow-on behaviors, including whether or not to fully infect the target and/or attempts specific actions."@en ;
	action:techniqueID "T1418" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1418> ;
	.

attack:T1418.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1418 ;
	rdfs:label "Software Discovery: Security Software Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of security applications and configurations that are installed on a device. This may include things such as mobile security products. Adversaries may use the information from Security Software Discovery during automated discovery to shape follow-on behaviors, including whether or not to fully infect the target and/or attempt specific actions."@en ;
	action:techniqueID "T1418.001" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1418/001> ;
	.

attack:T1419
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Device Type Discovery"@en ;
	rdfs:comment "On Android, device type information is accessible to apps through the android.os.Build class. Device information could be used to target privilege escalation exploits. Revoked by MITRE ATT&CK; superseded by T1426."@en ;
	action:techniqueID "T1419" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1426 ;
	dcterms:modified "2025-09-08"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1419> ;
	owl:deprecated true ;
	.

attack:T1420
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "File and Directory Discovery"@en ;
	rdfs:comment "Adversaries may enumerate files and directories or search in specific device locations for desired information within a filesystem. Adversaries may use the information from File and Directory Discovery during automated discovery to shape follow-on behaviors, including deciding if the adversary should fully infect the target and/or attempt specific actions."@en ;
	action:techniqueID "T1420" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1420> ;
	.

attack:T1421
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Network Connections Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of network connections to or from the compromised device they are currently accessing or from remote systems by querying for information over the network."@en ;
	action:techniqueID "T1421" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1421> ;
	.

attack:T1422
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Network Configuration Discovery"@en ;
	rdfs:comment "Adversaries may look for details about the network configuration and settings, such as IP and/or MAC addresses, of devices they access or through information discovery of remote systems."@en ;
	action:techniqueID "T1422" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1422> ;
	.

attack:T1422.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1422 ;
	rdfs:label "System Network Configuration Discovery: Internet Connection Discovery"@en ;
	rdfs:comment "Adversaries may check for Internet connectivity on compromised systems. This may be performed during automated discovery and can be accomplished in numerous ways such as using `adb shell netstat` for Android."@en ;
	action:techniqueID "T1422.001" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2024-02-20"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1422/001> ;
	.

attack:T1422.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1422 ;
	rdfs:label "System Network Configuration Discovery: Wi-Fi Discovery"@en ;
	rdfs:comment "Adversaries may search for information about Wi-Fi networks, such as network names and passwords, on compromised systems. Adversaries may use Wi-Fi information as part of Discovery or Credential Access activity to support both ongoing and future campaigns."@en ;
	action:techniqueID "T1422.002" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1422/002> ;
	.

attack:T1423
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Network Service Scanning"@en ;
	rdfs:comment "Adversaries may attempt to get a listing of services running on remote hosts, including those that may be vulnerable to remote software exploitation. Methods to acquire this information include port scans and vulnerability scans from the mobile device. This technique may take advantage of the mobile device's access to an internal enterprise network either through local connectivity or through a Virtual Private Network (VPN)."@en ;
	action:techniqueID "T1423" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1423> ;
	.

attack:T1424
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Process Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get information about running processes on a device. Information obtained could be used to gain an understanding of common software/applications running on devices within a network. Adversaries may use the information from Process Discovery during automated discovery to shape follow-on behaviors, including whether or not the adversary fully infects the target and/or attempts specific actions."@en ;
	action:techniqueID "T1424" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1424> ;
	.

attack:T1425
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Insecure Third-Party Libraries"@en ;
	rdfs:comment "MITRE ATT&CK technique T1425. Revoked by MITRE ATT&CK; superseded by T1474."@en ;
	action:techniqueID "T1425" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:isReplacedBy attack:T1474 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1425> ;
	owl:deprecated true ;
	.

attack:T1426
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "System Information Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get detailed information about a device’s operating system and hardware, including versions, patches, and architecture. Adversaries may use the information from System Information Discovery during automated discovery to shape follow-on behaviors, including whether or not to fully infects the target and/or attempts specific actions."@en ;
	action:techniqueID "T1426" ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1426> ;
	.

attack:T1427
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Attack PC via USB Connection"@en ;
	rdfs:comment "With escalated privileges, an adversary could program the mobile device to impersonate USB devices such as input devices (keyboard and mouse), storage devices, and/or networking devices in order to attack a physically connected PC This technique has been demonstrated on Android. We are unaware of any demonstrations on iOS. Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1427" ;
	dcterms:subject attack-tactic:TA0033 ;
	dcterms:coverage "Android" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-04-18"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1427> ;
	owl:deprecated true ;
	.

attack:T1428
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Exploitation of Remote Services"@en ;
	rdfs:comment "Adversaries may exploit remote services of enterprise servers, workstations, or other resources to gain unauthorized access to internal systems once inside of a network. Adversaries may exploit remote services by taking advantage of a mobile device’s access to an internal enterprise network through local connectivity or through a Virtual Private Network (VPN)."@en ;
	action:techniqueID "T1428" ;
	dcterms:subject attack-tactic:TA0033 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1428> ;
	.

attack:T1429
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Audio Capture"@en ;
	rdfs:comment "Adversaries may capture audio to collect information by leveraging standard operating system APIs of a mobile device. Examples of audio information adversaries may target include user conversations, surroundings, phone calls, or other sensitive information."@en ;
	action:techniqueID "T1429" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1429> ;
	.

attack:T1430
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Location Tracking"@en ;
	rdfs:comment "Adversaries may track a device’s physical location through use of standard operating system APIs via malicious or exploited applications on the compromised device."@en ;
	action:techniqueID "T1430" ;
	dcterms:subject attack-tactic:TA0035 ;
	dcterms:subject attack-tactic:TA0032 ;
	dcterms:coverage "Android" ;
	dcterms:coverage "iOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/mobile/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1430> ;
	.

attack:T1430.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1430 ;
	rdfs:label "Location Tracking: Remote Device Management Services"@en ;
	rdfs:comment "An adversary may use access to cloud services (e.g. Google's Android Device Manager or Apple iCloud's Find my iPhone) or to an enterprise mobility management (EMM)/mobile device management (MDM) server console to track the location of mobile devices managed by the service."@en ;
