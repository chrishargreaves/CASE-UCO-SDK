	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/009> ;
	.

attack:T1055.011
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: Extra Window Memory Injection"@en ;
	rdfs:comment "Adversaries may inject malicious code into process via Extra Window Memory (EWM) in order to evade process-based defenses as well as possibly elevate privileges. EWM injection is a method of executing arbitrary code in the address space of a separate live process."@en ;
	action:techniqueID "T1055.011" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/011> ;
	.

attack:T1055.012
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: Process Hollowing"@en ;
	rdfs:comment "Adversaries may inject malicious code into suspended and hollowed processes in order to evade process-based defenses. Process hollowing is a method of executing arbitrary code in the address space of a separate live process."@en ;
	action:techniqueID "T1055.012" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/012> ;
	.

attack:T1055.013
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: Process Doppelgänging"@en ;
	rdfs:comment "Adversaries may inject malicious code into process via process doppelgänging in order to evade process-based defenses as well as possibly elevate privileges. Process doppelgänging is a method of executing arbitrary code in the address space of a separate live process."@en ;
	action:techniqueID "T1055.013" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/013> ;
	.

attack:T1055.014
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: VDSO Hijacking"@en ;
	rdfs:comment "Adversaries may inject malicious code into processes via VDSO hijacking in order to evade process-based defenses as well as possibly elevate privileges. Virtual dynamic shared object (vdso) hijacking is a method of executing arbitrary code in the address space of a separate live process."@en ;
	action:techniqueID "T1055.014" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Linux" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/014> ;
	.

attack:T1055.015
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: ListPlanting"@en ;
	rdfs:comment "Adversaries may abuse list-view controls to inject malicious code into hijacked processes in order to evade process-based defenses as well as possibly elevate privileges. ListPlanting is a method of executing arbitrary code in the address space of a separate live process. Code executed via ListPlanting may also evade detection from security products since the execution is masked under a legitimate process."@en ;
	action:techniqueID "T1055.015" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1055/015> ;
	.

attack:T1056
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Input Capture"@en ;
	rdfs:comment "Adversaries may use methods of capturing user input to obtain credentials or collect information. During normal system usage, users often provide credentials to various different locations, such as login pages/portals or system dialog boxes. Input capture mechanisms may be transparent to the user (e.g. Credential API Hooking) or rely on deceiving the user into providing input into what they believe to be a genuine service (e.g. Web Portal Capture)."@en ;
	action:techniqueID "T1056" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1056> ;
	.

attack:T1056.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1056 ;
	rdfs:label "Input Capture: Keylogging"@en ;
	rdfs:comment "Adversaries may log user keystrokes to intercept credentials as the user types them. Keylogging is likely to be used to acquire credentials for new access opportunities when OS Credential Dumping efforts are not effective, and may require an adversary to intercept keystrokes on a system for a substantial period of time before credentials can be successfully captured."@en ;
	action:techniqueID "T1056.001" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1056/001> ;
	.

attack:T1056.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1056 ;
	rdfs:label "Input Capture: GUI Input Capture"@en ;
	rdfs:comment "Adversaries may mimic common operating system GUI components to prompt users for credentials with a seemingly legitimate prompt. When programs are executed that need additional privileges than are present in the current user context, it is common for the operating system to prompt the user for proper credentials to authorize the elevated privileges for the task (ex: Bypass User Account Control)."@en ;
	action:techniqueID "T1056.002" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1056/002> ;
	.

attack:T1056.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1056 ;
	rdfs:label "Input Capture: Web Portal Capture"@en ;
	rdfs:comment "Adversaries may install code on externally facing portals, such as a VPN login page, to capture and transmit credentials of users who attempt to log into the service. For example, a compromised login page may log provided user credentials before logging the user in to the service."@en ;
	action:techniqueID "T1056.003" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1056/003> ;
	.

attack:T1056.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1056 ;
	rdfs:label "Input Capture: Credential API Hooking"@en ;
	rdfs:comment "Adversaries may hook into Windows application programming interface (API) functions and Linux system functions to collect user credentials. Malicious hooking mechanisms may capture API or function calls that include parameters that reveal user authentication credentials. Unlike Keylogging, this technique focuses specifically on API functions that include parameters that reveal user credentials."@en ;
	action:techniqueID "T1056.004" ;
	dcterms:subject attack-tactic:TA0009 ;
	dcterms:subject attack-tactic:TA0006 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1056/004> ;
	.

attack:T1057
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Process Discovery"@en ;
	rdfs:comment "Adversaries may attempt to get information about running processes on a system. Information obtained could be used to gain an understanding of common software/applications running on systems within the network. Administrator or otherwise elevated access may provide better process details."@en ;
	action:techniqueID "T1057" ;
	dcterms:subject attack-tactic:TA0007 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1057> ;
	.

attack:T1058
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Service Registry Permissions Weakness"@en ;
	rdfs:comment "Windows stores local service configuration information in the Registry under HKLM\\SYSTEM\\CurrentControlSet\\Services. The information stored under a service's Registry keys can be manipulated to modify a service's execution parameters through tools such as the service controller, sc.exe, PowerShell, or Reg. Access to Registry keys is controlled through Access Control Lists and permissions. Revoked by MITRE ATT&CK; superseded by T1574.011."@en ;
	action:techniqueID "T1058" ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1574.011 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1058> ;
	owl:deprecated true ;
	.

attack:T1059
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Command and Scripting Interpreter"@en ;
	rdfs:comment "Adversaries may abuse command and script interpreters to execute commands, scripts, or binaries. These interfaces and languages provide ways of interacting with computer systems and are a common feature across many different platforms. Most systems come with some built-in command-line interface and scripting capabilities, for example, macOS and Linux distributions include some flavor of Unix Shell while Windows installations include the Windows Command Shell and PowerShell."@en ;
	action:techniqueID "T1059" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Containers" ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059> ;
	.

attack:T1059.001
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: PowerShell"@en ;
	rdfs:comment "Adversaries may abuse PowerShell commands and scripts for execution. PowerShell is a powerful interactive command-line interface and scripting environment included in the Windows operating system. Adversaries can use PowerShell to perform a number of actions, including discovery of information and execution of code."@en ;
	action:techniqueID "T1059.001" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/001> ;
	.

attack:T1059.002
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: AppleScript"@en ;
	rdfs:comment "Adversaries may abuse AppleScript for execution. AppleScript is a macOS scripting language designed to control applications and parts of the OS via inter-application messages called AppleEvents. These AppleEvent messages can be sent independently or easily scripted with AppleScript. These events can locate open windows, send keystrokes, and interact with almost any open application locally or remotely."@en ;
	action:techniqueID "T1059.002" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/002> ;
	.

attack:T1059.003
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Windows Command Shell"@en ;
	rdfs:comment "Adversaries may abuse the Windows command shell for execution. The Windows command shell (cmd) is the primary command prompt on Windows systems. The Windows command prompt can be used to control almost any aspect of a system, with various permission levels required for different subsets of commands. The command prompt can be invoked remotely via Remote Services such as SSH."@en ;
	action:techniqueID "T1059.003" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/003> ;
	.

attack:T1059.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Unix Shell"@en ;
	rdfs:comment "Adversaries may abuse Unix shell commands and scripts for execution. Unix shells are the primary command prompt on Linux, macOS, and ESXi systems, though many variations of the Unix shell exist (e.g. sh, ash, bash, zsh, etc.) depending on the specific OS or distribution. Unix shells can control every aspect of a system, with certain commands requiring elevated privileges."@en ;
	action:techniqueID "T1059.004" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/004> ;
	.

attack:T1059.005
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Visual Basic"@en ;
	rdfs:comment "Adversaries may abuse Visual Basic (VB) for execution. VB is a programming language created by Microsoft with interoperability with many Windows technologies such as Component Object Model and the Native API through the Windows API. Although tagged as legacy with no planned future evolutions, VB is integrated and supported in the .NET Framework and cross-platform .NET Core."@en ;
	action:techniqueID "T1059.005" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/005> ;
	.

attack:T1059.006
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Python"@en ;
	rdfs:comment "Adversaries may abuse Python commands and scripts for execution. Python is a very popular scripting/programming language, with capabilities to perform many functions. Python can be executed interactively from the command-line (via the python.exe interpreter) or via scripts (.py) that can be written and distributed to different systems. Python code can also be compiled into binary executables."@en ;
	action:techniqueID "T1059.006" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/006> ;
	.

attack:T1059.007
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: JavaScript"@en ;
	rdfs:comment "Adversaries may abuse various implementations of JavaScript for execution. JavaScript (JS) is a platform-independent scripting language (compiled just-in-time at runtime) commonly associated with scripts in webpages, though JS can be executed in runtime environments outside the browser."@en ;
	action:techniqueID "T1059.007" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/007> ;
	.

attack:T1059.008
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Network Device CLI"@en ;
	rdfs:comment "Adversaries may abuse scripting or built-in command line interpreters (CLI) on network devices to execute malicious command and payloads. The CLI is the primary means through which users and administrators interact with the device in order to view system information, modify device operations, or perform diagnostic and administrative functions. CLIs typically contain various permission levels required for different commands."@en ;
	action:techniqueID "T1059.008" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Network Devices" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/008> ;
	.

attack:T1059.009
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Cloud API"@en ;
	rdfs:comment "Adversaries may abuse cloud APIs to execute malicious commands. APIs available in cloud environments provide various functionalities and are a feature-rich method for programmatic access to nearly all aspects of a tenant. These APIs may be utilized through various methods such as command line interpreters (CLIs), in-browser Cloud Shells, PowerShell modules like Azure for PowerShell, or software developer kits (SDKs) available for languages such as Python."@en ;
	action:techniqueID "T1059.009" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "IaaS" ;
	dcterms:coverage "Identity Provider" ;
	dcterms:coverage "Office Suite" ;
	dcterms:coverage "SaaS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2026-05-12"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/009> ;
	.

attack:T1059.010
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: AutoHotKey & AutoIT"@en ;
	rdfs:comment "Adversaries may execute commands and perform malicious tasks using AutoIT and AutoHotKey automation scripts. AutoIT and AutoHotkey (AHK) are scripting languages that enable users to automate Windows tasks. These automation scripts can be used to perform a wide variety of actions, such as clicking on buttons, entering text, and opening and closing programs."@en ;
	action:techniqueID "T1059.010" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-04-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/010> ;
	.

attack:T1059.011
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Lua"@en ;
	rdfs:comment "Adversaries may abuse Lua commands and scripts for execution. Lua is a cross-platform scripting and programming language primarily designed for embedded use in applications. Lua can be executed on the command-line (through the stand-alone lua interpreter), via scripts (.lua), or from Lua-embedded programs (through the struct lua_State)."@en ;
	action:techniqueID "T1059.011" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Network Devices" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-04-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/011> ;
	.

attack:T1059.012
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Hypervisor CLI"@en ;
	rdfs:comment "Adversaries may abuse hypervisor command line interpreters (CLIs) to execute malicious commands. Hypervisor CLIs typically enable a wide variety of functionality for managing both the hypervisor itself and the guest virtual machines it hosts."@en ;
	action:techniqueID "T1059.012" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "ESXi" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-04-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/012> ;
	.

attack:T1059.013
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1059 ;
	rdfs:label "Command and Scripting Interpreter: Container CLI/API"@en ;
	rdfs:comment "Adversaries may abuse built-in CLI tools or API calls to execute malicious commands in containerized environments."@en ;
	action:techniqueID "T1059.013" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Containers" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-21"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1059/013> ;
	.

attack:T1060
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Registry Run Keys / Startup Folder"@en ;
	rdfs:comment "Adversaries may achieve persistence by adding a program to a startup folder or referencing it with a Registry run key. Adding an entry to the \"run keys\" in the Registry or startup folder will cause the program referenced to be executed when a user logs in. These programs will be executed under the context of the user and will have the account's associated permissions level. Revoked by MITRE ATT&CK; superseded by T1547.001."@en ;
	action:techniqueID "T1060" ;
	dcterms:subject attack-tactic:TA0003 ;
	dcterms:coverage "Windows" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:isReplacedBy attack:T1547.001 ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1060> ;
	owl:deprecated true ;
	.

attack:T1061
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Graphical User Interface"@en ;
	rdfs:comment "**This technique has been deprecated. Please use Remote Services where appropriate.** Deprecated by MITRE ATT&CK."@en ;
	action:techniqueID "T1061" ;
	dcterms:subject attack-tactic:TA0002 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
	dcterms:coverage "macOS" ;
	dcterms:isPartOf <https://attack.mitre.org/matrices/enterprise/> ;
	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1061> ;
	owl:deprecated true ;
