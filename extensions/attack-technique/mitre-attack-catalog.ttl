		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Drive-by Compromise"@en ;
	rdfs:comment "Adversaries may gain access to a system through a user visiting a website over the normal course of browsing. Multiple ways of delivering exploit code to a browser exist (i.e., Drive-by Target), including:"@en ;
	action:techniqueID "T1189" ;
	dcterms:subject attack-tactic:TA0001 ;
