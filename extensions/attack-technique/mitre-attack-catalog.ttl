attack:T1489
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Service Stop"@en ;
	rdfs:comment "Adversaries may stop or disable services on a system to render those services unavailable to legitimate users. Stopping critical services or processes can inhibit or stop response to an incident or aid in the adversary's overall objectives to cause damage to the environment."@en ;
	action:techniqueID "T1489" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
