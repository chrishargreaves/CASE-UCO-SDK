	.

attack:T1494
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Runtime Data Manipulation"@en ;
	rdfs:comment "Adversaries may modify systems in order to manipulate the data as it is accessed and displayed to an end user. By manipulating runtime data, adversaries may attempt to affect a business process, organizational understanding, and decision making. Revoked by MITRE ATT&CK; superseded by T1565.003."@en ;
	action:techniqueID "T1494" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
