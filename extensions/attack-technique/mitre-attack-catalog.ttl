	dcterms:modified "2025-10-24"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1487> ;
	owl:deprecated true ;
	.

attack:T1488
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Disk Content Wipe"@en ;
	rdfs:comment "Adversaries may erase the contents of storage devices on specific systems as well as large numbers of systems in a network to interrupt availability to system and network resources. Revoked by MITRE ATT&CK; superseded by T1561.001."@en ;
	action:techniqueID "T1488" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "Linux" ;
	dcterms:coverage "Windows" ;
