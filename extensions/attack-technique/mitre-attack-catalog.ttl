	dcterms:modified "2025-04-15"^^xsd:date ;
	rdfs:seeAlso <https://attack.mitre.org/techniques/T1496/003> ;
	.

attack:T1496.004
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1496 ;
	rdfs:label "Resource Hijacking: Cloud Service Hijacking"@en ;
	rdfs:comment "Adversaries may leverage compromised software-as-a-service (SaaS) applications to complete resource-intensive tasks, which may impact hosted service availability."@en ;
	action:techniqueID "T1496.004" ;
