	.

attack:T1490
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf action:Action ;
	rdfs:label "Inhibit System Recovery"@en ;
	rdfs:comment "Adversaries may delete or remove built-in data and turn off services designed to aid in the recovery of a corrupted system to prevent recovery. This may deny access to available backups and recovery options."@en ;
	action:techniqueID "T1490" ;
	dcterms:subject attack-tactic:TA0040 ;
	dcterms:coverage "Containers" ;
	dcterms:coverage "ESXi" ;
	dcterms:coverage "IaaS" ;
