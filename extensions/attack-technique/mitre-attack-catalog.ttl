	.

attack:T1055.009
	a
		owl:Class ,
		action:Technique
		;
	rdfs:subClassOf attack:T1055 ;
	rdfs:label "Process Injection: Proc Memory"@en ;
	rdfs:comment "Adversaries may inject malicious code into processes via the /proc filesystem in order to evade process-based defenses as well as possibly elevate privileges. Proc memory injection is a method of executing arbitrary code in the address space of a separate live process."@en ;
	action:techniqueID "T1055.009" ;
	dcterms:subject attack-tactic:TA0005 ;
	dcterms:subject attack-tactic:TA0004 ;
	dcterms:coverage "Linux" ;
